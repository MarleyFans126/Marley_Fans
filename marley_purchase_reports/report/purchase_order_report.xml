<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Marley Purchase Order Paper Format (running header/footer) -->
    <record id="paperformat_marley_purchase" model="report.paperformat">
        <field name="name">Marley Purchase Order A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- Marley Fans Purchase Order Report Action — always renders with
         the "PURCHASE ORDER" title (forced by the wrapper template). -->
    <record id="action_report_marley_purchase_order" model="ir.actions.report">
        <field name="name">Marley Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">marley_purchase_reports.report_marley_purchase_order</field>
        <field name="report_file">marley_purchase_reports.report_marley_purchase_order</field>
        <field name="print_report_name">'Purchase Order - %s' % object.name</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_marley_purchase"/>
    </record>

    <!-- Marley Fans Request for Quotation Report Action — always renders
         with the "REQUEST FOR QUOTATION" title. -->
    <record id="action_report_marley_rfq" model="ir.actions.report">
        <field name="name">Marley Request for Quotation</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">marley_purchase_reports.report_marley_rfq</field>
        <field name="report_file">marley_purchase_reports.report_marley_rfq</field>
        <field name="print_report_name">'Request for Quotation - %s' % object.name</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_marley_purchase"/>
    </record>

    <!-- Hide Odoo's built-in "Purchase Order" and "Request for Quotation"
         reports from the Print menu so only the Marley layout appears. -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
