<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Prefix the PO number with the financial year on the form -->
    <record id="purchase_order_view_form_inherit_marley" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.marley</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Show "<FY>/" right before the order name in the title -->
            <xpath expr="//h1/field[@name='name']" position="before">
                <field name="financial_year_label"
                       readonly="1"
                       class="oe_inline"
                       invisible="not financial_year_label"/><span invisible="not financial_year_label">/</span>
            </xpath>

            <!-- Header Print buttons:
                 - When the order is still draft/sent the "Print" button
                   should print the Marley Request for Quotation.
                 - When confirmed, "Print" prints the Marley Purchase Order. -->
            <xpath expr="//header//button[@name='print_quotation']" position="attributes">
                <attribute name="name">%(marley_purchase_reports.action_report_marley_rfq)d</attribute>
                <attribute name="type">action</attribute>
            </xpath>
            <xpath expr="//header//button[@name='%(purchase.action_report_purchase_order)d']"
                   position="attributes">
                <attribute name="name">%(marley_purchase_reports.action_report_marley_purchase_order)d</attribute>
            </xpath>

            <!-- Purchase Representative (shown on the printed PO) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="purchase_representative_id"
                       options="{'no_create': True, 'no_quick_create': True}"/>
            </xpath>

            <!-- Editable PDF sections — "Print Settings" tab -->
            <xpath expr="//notebook" position="inside">
                <page string="PO Print" name="marley_po_print">
                    <group>
                        <group string="Taxes &amp; Duties">
                            <field name="marley_taxes_text" nolabel="1"/>
                        </group>
                        <group string="Payment Terms">
                            <field name="marley_payment_text" nolabel="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Delivery Terms">
                            <field name="marley_delivery_text" nolabel="1"
                                   placeholder="Leave blank to use Incoterm + Expected Arrival"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
