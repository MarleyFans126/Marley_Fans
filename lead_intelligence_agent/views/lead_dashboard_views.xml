<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- LEAD SCOREBOARD: Tree View                              -->
    <!-- ════════════════════════════════════════════════════════ -->
    <record id="lead_intelligence_scoreboard_tree" model="ir.ui.view">
        <field name="name">crm.lead.scoreboard.list</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list default_order="x_lead_score desc" decoration-success="x_lead_grade == 'a'"
                  decoration-info="x_lead_grade == 'b'"
                  decoration-warning="x_lead_grade == 'c'"
                  decoration-danger="x_lead_grade == 'd'">
                <field name="name" string="Lead"/>
                <field name="contact_name"/>
                <field name="x_lead_score" string="Score"/>
                <field name="x_lead_grade" string="Grade" widget="badge"
                       decoration-success="x_lead_grade == 'a'"
                       decoration-info="x_lead_grade == 'b'"
                       decoration-warning="x_lead_grade == 'c'"
                       decoration-danger="x_lead_grade == 'd'"/>
                <field name="source_id"/>
                <field name="x_gstin" optional="hide"/>
                <field name="x_enriched" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage_id"/>
                <field name="expected_revenue" widget="monetary" optional="show"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- LEAD SCOREBOARD: Search View                            -->
    <!-- ════════════════════════════════════════════════════════ -->
    <record id="lead_intelligence_scoreboard_search" model="ir.ui.view">
        <field name="name">crm.lead.scoreboard.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="partner_name"/>
                <field name="x_gstin"/>
                <field name="user_id"/>

                <!-- Filters: Grades -->
                <filter name="grade_a" string="Grade A (Hot)"
                        domain="[('x_lead_grade', '=', 'a')]"/>
                <filter name="grade_b" string="Grade B"
                        domain="[('x_lead_grade', '=', 'b')]"/>
                <filter name="grade_c" string="Grade C"
                        domain="[('x_lead_grade', '=', 'c')]"/>
                <filter name="grade_d" string="Grade D"
                        domain="[('x_lead_grade', '=', 'd')]"/>
                <separator/>
                <filter name="enriched" string="Enriched"
                        domain="[('x_enriched', '=', True)]"/>
                <filter name="not_enriched" string="Not Enriched"
                        domain="[('x_enriched', '=', False)]"/>
                <separator/>
                <filter name="duplicates" string="Duplicates"
                        domain="[('x_duplicate_of', '!=', False)]"/>

                <!-- Group By -->
                <separator/>
                <filter name="group_salesperson" string="Salesperson"
                        context="{'group_by': 'user_id'}"/>
                <filter name="group_grade" string="Grade"
                        context="{'group_by': 'x_lead_grade'}"/>
                <filter name="group_source" string="Source"
                        context="{'group_by': 'source_id'}"/>
                <filter name="group_stage" string="Stage"
                        context="{'group_by': 'stage_id'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- ACTION: Lead Scoreboard                                 -->
    <!-- ════════════════════════════════════════════════════════ -->
    <record id="lead_intelligence_action_scoreboard" model="ir.actions.act_window">
        <field name="name">Lead Scoreboard</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="lead_intelligence_scoreboard_tree"/>
        <field name="search_view_id" ref="lead_intelligence_scoreboard_search"/>
        <field name="domain">[('type', '=', 'lead')]</field>
        <field name="context">{'default_type': 'lead'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leads scored yet. Leads are automatically scored on creation.
            </p>
        </field>
    </record>

    <!-- ACTION: Hot Leads (Grade A) -->
    <record id="lead_intelligence_action_hot_leads" model="ir.actions.act_window">
        <field name="name">🔥 Hot Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="lead_intelligence_scoreboard_tree"/>
        <field name="search_view_id" ref="lead_intelligence_scoreboard_search"/>
        <field name="domain">[('x_lead_grade', '=', 'a')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Grade A leads right now. Keep working on enrichment!
            </p>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════ -->
    <!-- MENU: CRM > Lead Intelligence                           -->
    <!-- ════════════════════════════════════════════════════════ -->
    <menuitem id="lead_intelligence_menu_root"
              name="Lead Intelligence"
              parent="crm.crm_menu_root"
              sequence="8"/>

    <menuitem id="lead_intelligence_menu_scoreboard"
              name="Lead Scoreboard"
              parent="lead_intelligence_menu_root"
              action="lead_intelligence_action_scoreboard"
              sequence="10"/>

    <menuitem id="lead_intelligence_menu_hot_leads"
              name="🔥 Hot Leads"
              parent="lead_intelligence_menu_root"
              action="lead_intelligence_action_hot_leads"
              sequence="20"/>

</odoo>
