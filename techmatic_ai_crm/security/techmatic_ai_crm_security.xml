<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Odoo 19 introduced res.groups.privilege to group security groups
        in the Users form. We anchor it to the standard ``Sales/CRM``
        module category so our groups show under the CRM section.
    -->
    <record id="module_category_techmatic_ai_crm" model="ir.module.category">
        <field name="name">AI CRM Assistant</field>
        <field name="description">Access levels for the AI CRM Assistant module.</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_techmatic_ai_crm" model="res.groups.privilege">
        <field name="name">AI CRM Assistant</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_techmatic_ai_crm"/>
    </record>

    <!--
        Two-tier model:
        - User  : can chat with the assistant, run AI on their own leads.
        - Admin : User + can change API keys / provider / model.
        Implicit: anyone NOT in either group sees the lead fields readonly
        and no AI buttons in the UI.
    -->
    <record id="group_techmatic_ai_crm_user" model="res.groups">
        <field name="name">AI CRM: User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_techmatic_ai_crm"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can use the AI Assistant panel and AI buttons on CRM leads.</field>
    </record>

    <record id="group_techmatic_ai_crm_admin" model="res.groups">
        <field name="name">AI CRM: Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_techmatic_ai_crm"/>
        <field name="implied_ids" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Can configure AI provider, keys, prompts, and prompt templates.</field>
    </record>

    <!--
        Record rules:
        Users can read/write only their OWN chat sessions and messages.
        Admins see everything.
    -->
    <record id="rule_ai_chat_session_user_own" model="ir.rule">
        <field name="name">AI Chat Session: own only</field>
        <field name="model_id" ref="model_techmatic_ai_chat_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ai_chat_session_admin_all" model="ir.rule">
        <field name="name">AI Chat Session: admins see all</field>
        <field name="model_id" ref="model_techmatic_ai_chat_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_admin'))]"/>
    </record>

    <record id="rule_ai_chat_message_user_own" model="ir.rule">
        <field name="name">AI Chat Message: own only</field>
        <field name="model_id" ref="model_techmatic_ai_chat_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ai_chat_message_admin_all" model="ir.rule">
        <field name="name">AI Chat Message: admins see all</field>
        <field name="model_id" ref="model_techmatic_ai_chat_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_admin'))]"/>
    </record>

    <!--
        Daily Briefing: users see only their own briefings; admins see
        the full org. The cron writes as ``base.user_root`` so it
        bypasses these rules.
    -->
    <record id="rule_ai_daily_briefing_user_own" model="ir.rule">
        <field name="name">AI Daily Briefing: own only</field>
        <field name="model_id" ref="model_techmatic_ai_daily_briefing"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_ai_daily_briefing_admin_all" model="ir.rule">
        <field name="name">AI Daily Briefing: admins see all</field>
        <field name="model_id" ref="model_techmatic_ai_daily_briefing"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_admin'))]"/>
    </record>

    <!--
        Auto Follow-Up Log: salespeople can audit emails sent on their
        own behalf; admins see everything.
    -->
    <record id="rule_ai_auto_followup_log_user_own" model="ir.rule">
        <field name="name">Auto Follow-Up Log: own only</field>
        <field name="model_id" ref="model_techmatic_ai_auto_followup_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_ai_auto_followup_log_admin_all" model="ir.rule">
        <field name="name">Auto Follow-Up Log: admins see all</field>
        <field name="model_id" ref="model_techmatic_ai_auto_followup_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('techmatic_ai_crm.group_techmatic_ai_crm_admin'))]"/>
    </record>

</odoo>
