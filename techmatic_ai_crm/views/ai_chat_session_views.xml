<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_chat_session_view_tree" model="ir.ui.view">
        <field name="name">techmatic.ai.chat.session.list</field>
        <field name="model">techmatic.ai.chat.session</field>
        <field name="arch" type="xml">
            <list string="AI Sessions">
                <field name="title"/>
                <field name="user_id"/>
                <field name="lead_id"/>
                <field name="message_count"/>
                <field name="last_message_preview"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="ai_chat_session_view_form" model="ir.ui.view">
        <field name="name">techmatic.ai.chat.session.form</field>
        <field name="model">techmatic.ai.chat.session</field>
        <field name="arch" type="xml">
            <form string="AI Session">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <field name="user_id"/>
                        <field name="lead_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids">
                                <list create="false" delete="false">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="body"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_chat_session" model="ir.actions.act_window">
        <field name="name">AI Sessions</field>
        <field name="res_model">techmatic.ai.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
