<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_prompt_template_view_tree" model="ir.ui.view">
        <field name="name">techmatic.ai.prompt.template.list</field>
        <field name="model">techmatic.ai.prompt.template</field>
        <field name="arch" type="xml">
            <list string="AI Prompt Templates">
                <field name="name"/>
                <field name="key"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="ai_prompt_template_view_form" model="ir.ui.view">
        <field name="name">techmatic.ai.prompt.template.form</field>
        <field name="model">techmatic.ai.prompt.template</field>
        <field name="arch" type="xml">
            <form string="AI Prompt Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="key"/>
                        <field name="category"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                    <group string="System Prompt">
                        <field name="system_prompt" nolabel="1" widget="text"/>
                    </group>
                    <group string="User Prompt Template">
                        <field name="user_prompt_template" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_prompt_template" model="ir.actions.act_window">
        <field name="name">AI Prompt Templates</field>
        <field name="res_model">techmatic.ai.prompt.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
