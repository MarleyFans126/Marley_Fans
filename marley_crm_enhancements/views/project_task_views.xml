<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Task Form: Add Installation Tab -->
    <record id="project_task_view_form_inherit_installation" model="ir.ui.view">
        <field name="name">project.task.form.installation</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- Send buttons in the header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_installation_report_email"
                        string="Send by Email"
                        type="object"
                        class="btn-secondary"
                        icon="fa-envelope"
                        groups="project.group_project_user"/>
                <button name="action_send_installation_report_whatsapp"
                        string="Send by WhatsApp"
                        type="object"
                        class="btn-secondary text-success"
                        icon="fa-whatsapp"
                        groups="project.group_project_user"/>
            </xpath>

            <!-- Rename "Deadline" label to "Dispatch Date" -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="string">Dispatch Date</attribute>
            </xpath>

            <!-- Project is always the shared Installation project — not editable -->
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Move Sales Representative + Scheduled Installation Date
                 to the top-right group, right after Dispatch Date -->
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="inst_sales_rep"/>
                <field name="inst_installation_date"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Installation" name="installation_tab">

                    <!-- Installation toggle (refresh is automatic) -->
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <field name="is_installation" widget="boolean_toggle"/>
                        <label for="is_installation" string="This is an Installation Task"/>
                    </div>

                    <div invisible="not is_installation">

                        <!-- Row 1: Bill To (contact + billing company / GSTIN) -->
                        <group string="Bill To Details">
                            <group>
                                <field name="inst_site_contact"/>
                                <field name="inst_site_phone" widget="phone"/>
                            </group>
                            <group>
                                <field name="inst_company_name"/>
                                <field name="inst_company_address"/>
                                <field name="inst_gstin"/>
                            </group>
                        </group>

                        <!-- Ship To (installation site address + site GSTIN) -->
                        <group string="Ship To Details">
                            <group>
                                <field name="inst_site_address_street" placeholder="Street address..."/>
                                <field name="inst_site_address_street2" placeholder="Street address line 2..."/>
                                <field name="inst_site_address_city" placeholder="City"/>
                            </group>
                            <group>
                                <field name="inst_site_address_state_id" placeholder="Select State..."/>
                                <field name="inst_site_address_zip" placeholder="Pincode"/>
                                <field name="inst_site_gstin" placeholder="Site GST Number"/>
                            </group>
                        </group>

                        <!-- Row 2: Transport / Invoice -->
                        <group string="Product Model / Quantity / Weight / Terms">
                            <group>
                                <field name="inst_transportation_terms"/>
                            </group>
                            <group>
                                <field name="inst_basic_value" string="Basic Value" widget="monetary"/>
                                <field name="inst_gst_value" string="GST Value (18%)" widget="monetary" readonly="1"/>
                                <field name="inst_invoice_value" string="Total" widget="monetary" readonly="1"/>
                                <field name="inst_amount_in_words" readonly="1"/>
                                <field name="inst_payment_terms_text"/>
                            </group>
                        </group>

                        <!-- Row 3: Link to Sale Order -->
                        <group string="Linked Sale Order" invisible="not sale_order_id">
                            <group>
                                <field name="sale_order_id" readonly="1"/>
                            </group>
                        </group>

                        <!-- Editable Installation Product Lines -->
                        <group string="Installation Product Lines">
                            <div class="mb-2">
                                <button name="action_fill_installation_lines_from_so"
                                        type="object"
                                        string="Import from Sale Order"
                                        class="btn-sm btn-outline-primary"
                                        icon="fa-download"
                                        help="Replace lines with data from the linked sale order."/>
                            </div>
                            <field name="installation_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom" string="Installation Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="weight"/>
                                    <field name="unit_price"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <field name="inst_total_quantity" readonly="1"/>
                                <field name="inst_total_weight" readonly="1"/>
                                <field name="inst_grand_total" widget="monetary" readonly="1"/>
                            </group>
                        </group>

                        <!-- Row 4: Site Specification -->
                        <group string="Site Specification">
                            <group>
                                <field name="inst_ext_rod_length" placeholder="e.g. 500 mm"/>
                                <field name="inst_field_height" placeholder="e.g. 6 MTR Meter"/>
                                <field name="inst_electrical_wire" placeholder="e.g. 150 Meter"/>
                                <field name="inst_height_arrangement_scope"/>
                            </group>
                            <group>
                                <field name="inst_mounting_structure"/>
                                <field name="inst_crane_rafter_distance" placeholder="e.g. 200 mm"/>
                                <field name="inst_stay_arrangement_scope"/>
                            </group>
                        </group>

                        <!-- Row 5: Other Info -->
                        <group string="Other Important Information">
                            <field name="inst_other_info" nolabel="1" colspan="2"
                                   placeholder="Payment terms, delivery notes, special instructions..."/>
                        </group>

                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ================================================================
         Dispatch / Installation date: searchable filters + a calendar.
         "Dispatch Date" is the standard task Deadline (date_deadline), which
         already drives the standard task Calendar. We just relabel the filter
         (it was called "Deadline") and add the same for Installation Date.
         ================================================================ -->
    <record id="project_task_search_marley_dates" model="ir.ui.view">
        <field name="name">project.task.search.marley.dates</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <!-- Relabel the "Deadline" date filter -> "Dispatch Date" and add
                 an Installation Date filter right after it. -->
            <filter name="date_deadline" position="attributes">
                <attribute name="string">Dispatch Date</attribute>
            </filter>
            <filter name="date_deadline" position="after">
                <filter string="Installation Date" name="inst_installation_date_filter"
                        date="inst_installation_date"/>
            </filter>
            <!-- Relabel the "Deadline" group-by -> "Dispatch Date" and add an
                 Installation Date group-by. -->
            <filter name="deadline" position="attributes">
                <attribute name="string">Dispatch Date</attribute>
            </filter>
            <filter name="deadline" position="after">
                <filter string="Installation Date" name="group_inst_installation_date"
                        context="{'group_by': 'inst_installation_date'}"/>
            </filter>
        </field>
    </record>

    <!-- Dispatch-date calendar: tasks shown on their Dispatch Date
         (date_deadline). -->
    <record id="project_task_calendar_dispatch" model="ir.ui.view">
        <field name="name">project.task.calendar.dispatch</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar string="Dispatch Calendar" date_start="date_deadline"
                      color="stage_id" mode="month" quick_create="0"
                      event_open_popup="true">
                <field name="inst_company_name"/>
                <field name="stage_id"/>
                <field name="user_ids"/>
            </calendar>
        </field>
    </record>

    <record id="action_dispatch_calendar" model="ir.actions.act_window">
        <field name="name">Dispatch Calendar</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('date_deadline', '!=', False)]</field>
        <field name="context">{}</field>
    </record>
    <record id="action_dispatch_calendar_cal_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="project_task_calendar_dispatch"/>
        <field name="act_window_id" ref="action_dispatch_calendar"/>
    </record>
    <menuitem id="menu_dispatch_calendar"
              name="Dispatch Calendar"
              parent="project.menu_main_pm"
              action="action_dispatch_calendar"
              sequence="44"/>

    <!-- Installation-date calendar: tasks shown on their Installation Date. -->
    <record id="project_task_calendar_installation" model="ir.ui.view">
        <field name="name">project.task.calendar.installation</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <calendar string="Installation Calendar" date_start="inst_installation_date"
                      color="stage_id" mode="month" quick_create="0"
                      event_open_popup="true" hide_time="true">
                <field name="inst_company_name"/>
                <field name="stage_id"/>
                <field name="user_ids"/>
            </calendar>
        </field>
    </record>

    <record id="action_installation_calendar" model="ir.actions.act_window">
        <field name="name">Installation Calendar</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('inst_installation_date', '!=', False)]</field>
        <field name="context">{}</field>
    </record>
    <record id="action_installation_calendar_cal_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="project_task_calendar_installation"/>
        <field name="act_window_id" ref="action_installation_calendar"/>
    </record>

    <menuitem id="menu_installation_calendar"
              name="Installation Calendar"
              parent="project.menu_main_pm"
              action="action_installation_calendar"
              sequence="45"/>

</odoo>
