<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Create Quotation" button and Project field on lead form -->
    <record id="crm_lead_view_form_inherit_marley" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.marley</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- Order Booking Form smart button — visible only when tasks exist -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_project"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        invisible="project_count == 0">
                    <field name="project_count" widget="statinfo" string="Order Booking Form"/>
                </button>
            </xpath>

            <!-- Create Quotation / Create Task buttons in header -->
            <xpath expr="//form//header" position="inside">
                <button name="action_create_quotation"
                        string="Create Quotation"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-text-o"/>
                <button name="action_create_project"
                        string="Create Order Booking Form"
                        type="object"
                        class="btn-primary"
                        icon="fa-tasks"/>
                <button name="action_send_intro_email"
                        string="Send Intro Email"
                        type="object"
                        class="btn-secondary"
                        icon="fa-envelope-o"/>
            </xpath>

            <!-- Hide the standard "New Quotation" button (from sale_crm) —
                 Marley uses its own "Create Quotation" button instead. -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Project link field after team_id -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="project_id" readonly="1"
                       invisible="not project_id"/>
            </xpath>

            <!-- Loss info section — visible only when lead is lost -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="loss_reason_id" readonly="1"
                       invisible="not loss_reason_id"
                       string="Loss Reason"/>
                <field name="loss_remarks" readonly="1"
                       invisible="not loss_remarks"
                       string="Loss Remarks"/>
            </xpath>

        </field>
    </record>

    <!-- Show Loss Reason + Loss Remarks as optional columns in the opportunity
         list, so lost leads can be scanned without opening each one.
         optional="show" = visible by default; users can toggle via the column
         picker. -->
    <record id="crm_case_tree_view_oppor_loss_marley" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.loss.marley</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="loss_reason_id" optional="show"/>
                <field name="loss_remarks" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
