<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Order Booking Form task visibility.

        A regular user sees an order-booking task (is_installation = True) only
        when they own it: they are an assignee, OR the Salesperson / Second
        Salesperson of the linked lead. Project Administrators and Sales users
        with "All Documents" / "Administrator" access see every order-booking
        task. Ordinary (non-order-booking) project tasks are unaffected -
        everyone keeps their normal project visibility.

        This is a GLOBAL rule so it AND-restricts on top of the standard,
        permissive project rules (group rules only OR together and could not
        tighten access on their own).
    -->
    <record id="rule_order_booking_task_owner" model="ir.rule">
        <field name="name">Order Booking Form: owner sees own; Admins see all</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('project.group_project_manager') or user.has_group('sales_team.group_sale_salesman_all_leads')) else ['|', '|', '|', ('is_installation', '=', False), ('user_ids', 'in', user.id), ('lead_id.user_id', '=', user.id), ('lead_id.second_salesperson_id', '=', user.id)]</field>
    </record>
</odoo>
