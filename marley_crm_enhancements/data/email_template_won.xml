<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email sent to client when Lead is marked as Won -->
        <record id="email_template_won_client_confirmation" model="mail.template">
            <field name="name">Lead Won — Client Confirmation (Marley Fans)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Order Confirmation — {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
                    <p style="font-size: 14px;">
                        Dear <t t-out="object.contact_name or object.partner_name or 'Customer'"/>,
                    </p>
                    <p style="font-size: 13px;">
                        Thank you for choosing <strong>Marley Fans</strong>!
                    </p>
                    <p style="font-size: 13px;">
                        We are pleased to confirm that your order for
                        <strong><t t-out="object.name"/></strong> has been accepted
                        and is now being processed.
                    </p>
                    <p style="font-size: 13px;">
                        Our team will be in touch shortly with the next steps
                        regarding delivery and installation.
                    </p>
                    <p style="font-size: 13px;">
                        If you have any questions, please do not hesitate to contact
                        your dedicated representative:
                    </p>
                    <ul style="font-size: 13px;">
                        <li><strong>Name:</strong> <t t-out="object.user_id.name or 'Sales Team'"/></li>
                        <li><strong>Email:</strong> <t t-out="object.user_id.email or 'sales@marleyfans.com'"/></li>
                        <li><strong>Phone:</strong> <t t-out="object.user_id.partner_id.phone or 'N/A'"/></li>
                    </ul>
                    <br/>
                    <p style="font-size: 13px;">
                        Warm regards,<br/>
                        <strong>Marley Fans Sales Team</strong>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
