<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Salespeople create installation projects / tasks from won leads, so
        the CRM "Salesperson" group implies the Project "User" group. This
        grants the proper project.task / project.project access AND the
        record rules those models require (a plain ir.model.access grant is
        not enough — task access is gated by record rules bound to the
        Project User group). Applies to every salesperson automatically.
    -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
</odoo>
