<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!--
        Update the EXISTING default CRM stages to match FRD naming/sequencing.
        These reference Odoo's built-in XML IDs — no new records are created.
    -->

    <record id="crm.stage_lead1" model="crm.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
    </record>

    <record id="crm.stage_lead2" model="crm.stage">
        <field name="name">Qualify</field>
        <field name="sequence">2</field>
    </record>

    <record id="crm.stage_lead3" model="crm.stage">
        <field name="name">Proposition</field>
        <field name="sequence">3</field>
    </record>

    <record id="crm.stage_lead4" model="crm.stage">
        <field name="name">Won</field>
        <field name="sequence">10</field>
        <field name="is_won">True</field>
    </record>

</odoo>
