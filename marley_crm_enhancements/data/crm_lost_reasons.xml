<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Loss Reasons as per FRD §5.2.2 -->

    <record id="lost_reason_price" model="crm.lost.reason">
        <field name="name">Price too high</field>
    </record>

    <record id="lost_reason_competitor" model="crm.lost.reason">
        <field name="name">Competitor selected</field>
    </record>

    <record id="lost_reason_requirement" model="crm.lost.reason">
        <field name="name">Requirement changed</field>
    </record>

    <record id="lost_reason_no_response" model="crm.lost.reason">
        <field name="name">No response</field>
    </record>

    <record id="lost_reason_budget" model="crm.lost.reason">
        <field name="name">Budget not approved</field>
    </record>

    <record id="lost_reason_others" model="crm.lost.reason">
        <field name="name">Others</field>
    </record>

</odoo>
