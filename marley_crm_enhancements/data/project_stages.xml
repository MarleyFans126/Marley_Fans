<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": seed these task stages once on install, but NEVER
         overwrite them on later module upgrades. Without this, every
         `-u marley_crm_enhancements` re-imported the records and reset any
         stage the user had renamed/re-sequenced in the UI. -->
    <data noupdate="1">

        <!-- Installation stage for project tasks -->
        <record id="project_stage_installation" model="project.task.type">
            <field name="name">Installation</field>
            <field name="sequence">5</field>
            <field name="fold">False</field>
        </record>

        <!-- Additional useful stages -->
        <record id="project_stage_in_progress" model="project.task.type">
            <field name="name">In Progress</field>
            <field name="sequence">10</field>
            <field name="fold">False</field>
        </record>

        <record id="project_stage_done" model="project.task.type">
            <field name="name">Done</field>
            <field name="sequence">20</field>
            <field name="fold">True</field>
        </record>

        <record id="project_stage_cancelled" model="project.task.type">
            <field name="name">Cancelled</field>
            <field name="sequence">30</field>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
