<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_task_installation">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <style>
                    @page { margin-top: 0mm !important; }
                    .article { margin-top: 0 !important; padding-top: 0 !important; }
                    table td, table th {
                        -webkit-print-color-adjust: exact;
                    }
                </style>

                <!-- ============ RUNNING HEADER (repeats on every page) ============ -->
                <div class="header" style="margin: 0; padding: 10px 0;">
                    <div style="padding: 8px 30px;">
                        <img src="/marley_crm_enhancements/static/src/img/marley_logo.png"
                             style="max-height: 70px;" alt="Marley HVLS Fans"/>
                    </div>
                </div>

                <!-- ============ RUNNING FOOTER (repeats on every page) ============ -->
                <div class="footer" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                    <div style="border-top: 3px solid #e30613; padding-top: 8px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 9px; color: #333; border: none; letter-spacing: 0.2px; table-layout: fixed; table-layout: fixed;">
                            <tr>
                                <td style="width: 28%; vertical-align: top; border: none; padding: 0 8px 0 0; overflow: hidden; word-break: keep-all;">
                                    <strong style="color: #e30613;">Website:</strong> www.marleyfans.in
                                </td>
                                <td style="width: 40%; vertical-align: top; border: none; padding: 0 8px; text-align: center; overflow: hidden;">
                                    <strong style="color: #e30613;">CIN:</strong> U29308TG2021PTC156778
                                </td>
                                <td style="width: 32%; vertical-align: top; border: none; padding: 0 0 0 8px; text-align: right; overflow: hidden;">
                                    <strong style="color: #e30613;">GSTIN:</strong> 36AAPCM1629P1ZS
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="padding: 4px 0 0 0; font-size: 8px; border: none; white-space: nowrap;">
                                    <strong style="color: #e30613;">Corporate Address:</strong> Second Floor, Swapna Nilayam, H.NO.5-5-81/7/A, Plot No.20, High Tension Rd, Prakash Nagar, Kukatpally, Hyderabad, Telangana 500072, India
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- ============ PAGE BODY ============ -->
                <div class="page" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1a1a2e; font-size: 13px;">

                    <!-- ============ TITLE ============ -->
                    <div style="text-align: center; margin: 10px 0 22px 0;">
                        <span style="font-size: 20px; font-weight: bold; color: #e30613; text-decoration: underline; letter-spacing: 1px;">
                            Installation for: <t t-esc="doc.inst_company_name or doc.partner_id.commercial_partner_id.name or '-'"/>
                        </span>
                    </div>

                    <!-- ============ DETAILS TABLE ============ -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #f5a9ac;">
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; width: 38%; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Sales Representative
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_sales_rep or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Scheduled Installation Date
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_installation_date">
                                    <t t-esc="doc.inst_installation_date" t-options='{"widget": "date", "format": "MMM dd, yyyy"}'/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                Company Details
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                <t t-esc="doc.inst_company_name or doc.partner_id.commercial_partner_id.name or ''"/><br/>
                                <t t-if="doc.inst_company_address">
                                    <span style="white-space: pre-wrap;"><t t-esc="doc.inst_company_address"/></span><br/>
                                </t>
                                <!-- Fallback: show partner address directly if inst_company_address is empty -->
                                <t t-if="not doc.inst_company_address and doc.partner_id">
                                    <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/>,<br/></t>
                                    <t t-if="doc.partner_id.street2"><t t-esc="doc.partner_id.street2"/>,<br/></t>
                                    <t t-if="doc.partner_id.city"><t t-esc="doc.partner_id.city"/></t>
                                    <t t-if="doc.partner_id.state_id"> <t t-esc="doc.partner_id.state_id.name"/></t>
                                    <t t-if="doc.partner_id.country_id"> (<t t-esc="doc.partner_id.country_id.code"/>)</t>
                                    <t t-if="doc.partner_id.zip"> <t t-esc="doc.partner_id.zip"/>.</t>
                                    <br/>
                                </t>
                                <t t-if="doc.inst_gstin">
                                    GSTIN <t t-esc="doc.inst_gstin"/>
                                </t>
                                <t t-if="not doc.inst_gstin and doc.partner_id.vat">
                                    GSTIN <t t-esc="doc.partner_id.vat"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                Site Contact Person<br/>
                                Contact number
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                <t t-esc="doc.inst_site_contact or ''"/><br/>
                                <t t-esc="doc.inst_site_phone or ''"/>
                            </td>
                        </tr>
                        <t t-if="doc.inst_site_address_street or doc.inst_site_address_city">
                            <tr>
                                <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                    Installation Site Address
                                </td>
                                <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                    <t t-if="doc.inst_site_address_street"><t t-esc="doc.inst_site_address_street"/>,<br/></t>
                                    <t t-if="doc.inst_site_address_street2"><t t-esc="doc.inst_site_address_street2"/>,<br/></t>
                                    <t t-if="doc.inst_site_address_city"><t t-esc="doc.inst_site_address_city"/></t>
                                    <t t-if="doc.inst_site_address_state_id"> <t t-esc="doc.inst_site_address_state_id.name"/></t>
                                    <t t-if="doc.inst_site_address_zip"> - <t t-esc="doc.inst_site_address_zip"/></t>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <!-- ============ PRODUCT MODEL / TERMS ============ -->
                    <h4 style="text-align: center; color: #333; font-weight: bold; font-size: 14px; margin: 22px 0 12px 0;">
                        Product &amp; Packaging Details
                    </h4>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #f5a9ac;">
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; width: 60%; font-size: 14px; vertical-align: middle;">
                                Models to transport
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                | <t t-esc="doc.inst_models_to_transport or ''"/> |
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                Transportation terms:
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_transportation_terms == 'paid'">Paid</t>
                                <t t-if="doc.inst_transportation_terms == 'to_pay'">To Pay</t>
                                <t t-if="doc.inst_transportation_terms == 'to_be_billed'">To be Billed</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Invoice Value:
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_invoice_value">
                                    <t t-esc="'{:,.1f}'.format(doc.inst_invoice_value)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Advance Received:
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_advance_received">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.inst_advance_received)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Balance Amount:
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle; font-weight: bold;">
                                <t t-if="doc.inst_balance_amount">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.inst_balance_amount)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Amount In Words:
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_amount_in_words or ''"/>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ PRODUCT LINES TABLE ============ -->
                    <!-- Only render the editable task lines. If the task has none, no table is printed. -->
                    <t t-set="use_task_lines" t-value="True"/>
                    <t t-set="product_lines" t-value="doc.installation_line_ids"/>
                    <t t-if="product_lines">
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; page-break-inside: auto;">
                                <thead>
                                    <tr style="border-top: 2px solid #f5a9ac; border-bottom: 2px solid #f5a9ac;">
                                        <th style="padding: 10px 12px; text-align: left; font-weight: bold; font-size: 13px; color: #555; width: 7%;">
                                            Sr. No.
                                        </th>
                                        <th style="padding: 10px 12px; text-align: left; font-weight: bold; font-size: 13px; color: #555; width: 33%;">
                                            Product
                                        </th>
                                        <th style="padding: 10px 12px; text-align: center; font-weight: bold; font-size: 13px; color: #555; width: 12%;">
                                            Quantity
                                        </th>
                                        <th style="padding: 10px 12px; text-align: right; font-weight: bold; font-size: 13px; color: #555; width: 12%;">
                                            Weight
                                        </th>
                                        <th style="padding: 10px 12px; text-align: right; font-weight: bold; font-size: 13px; color: #555; width: 17%;">
                                            Unit Price
                                        </th>
                                        <th style="padding: 10px 12px; text-align: right; font-weight: bold; font-size: 13px; color: #555; width: 19%;">
                                            Total Price
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sno" t-value="0"/>
                                    <t t-set="grand_total" t-value="0"/>
                                    <t t-set="total_qty" t-value="0"/>
                                    <t t-set="total_weight" t-value="0"/>
                                    <t t-foreach="product_lines" t-as="line">
                                        <t t-set="sno" t-value="sno + 1"/>
                                        <t t-if="use_task_lines">
                                            <t t-set="l_qty" t-value="line.quantity"/>
                                            <t t-set="l_uom" t-value="line.uom_id"/>
                                            <t t-set="l_price" t-value="line.unit_price"/>
                                            <t t-set="l_subtotal" t-value="line.price_subtotal"/>
                                            <t t-set="l_weight" t-value="line.weight"/>
                                            <t t-set="l_label" t-value="line.product_id.name or line.name or ''"/>
                                        </t>
                                        <t t-if="not use_task_lines">
                                            <t t-set="l_qty" t-value="line.product_uom_qty"/>
                                            <t t-set="l_uom" t-value="line.product_uom_id"/>
                                            <t t-set="l_price" t-value="line.price_unit"/>
                                            <t t-set="l_subtotal" t-value="line.price_subtotal"/>
                                            <t t-set="l_weight" t-value="(line.product_id.marley_weight or line.product_id.weight or 0.0) * line.product_uom_qty"/>
                                            <t t-set="l_label" t-value="line.product_id.name or line.name or ''"/>
                                        </t>
                                        <t t-set="grand_total" t-value="grand_total + l_subtotal"/>
                                        <t t-set="total_qty" t-value="total_qty + l_qty"/>
                                        <t t-set="total_weight" t-value="total_weight + l_weight"/>
                                        <tr style="border-bottom: 1px solid #f5a9ac; page-break-inside: avoid;">
                                            <td style="padding: 14px 12px; text-align: center; font-size: 13px; vertical-align: top;">
                                                <t t-esc="sno"/>
                                            </td>
                                            <td style="padding: 14px 12px; font-size: 13px; vertical-align: top;">
                                                <t t-esc="l_label"/>
                                            </td>
                                            <td style="padding: 14px 12px; text-align: center; font-size: 13px; vertical-align: top;">
                                                <t t-esc="'%.2f' % l_qty"/>
                                                <t t-if="l_uom"> <t t-esc="l_uom.name"/></t>
                                            </td>
                                            <td style="padding: 14px 12px; text-align: right; font-size: 13px; vertical-align: top;">
                                                <t t-esc="'%.2f' % l_weight"/> kg
                                            </td>
                                            <td style="padding: 14px 12px; text-align: right; font-size: 13px; vertical-align: top;">
                                                &#8377; <t t-esc="'{:,.2f}'.format(l_price)"/>
                                            </td>
                                            <td style="padding: 14px 12px; text-align: right; font-size: 13px; vertical-align: top; font-weight: bold;">
                                                &#8377; <t t-esc="'{:,.2f}'.format(l_subtotal)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- TOTALS ROW -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; border-top: 2px solid #f5a9ac; border-bottom: 2px solid #f5a9ac; page-break-inside: avoid;">
                                <tr>
                                    <td style="padding: 10px 14px; width: 34%; font-size: 13px;">
                                        <strong>Total Quantity:</strong>&#160;&#160;
                                        <t t-esc="'%.2f' % total_qty"/>
                                    </td>
                                    <td style="padding: 10px 14px; width: 33%; font-size: 13px; border-left: 1px solid #f5a9ac;">
                                        <strong>Total Weight:</strong>&#160;&#160;
                                        <t t-esc="'%.2f' % total_weight"/> kg
                                    </td>
                                    <td style="padding: 10px 14px; width: 33%; font-size: 14px; text-align: right; border-left: 1px solid #f5a9ac;">
                                        <strong>Grand Total:</strong>&#160;&#160;
                                        &#8377; <t t-esc="'{:,.2f}'.format(grand_total)"/>
                                    </td>
                                </tr>
                            </table>
                    </t>

                    <!-- ============ SITE SPECIFICATION ============ -->
                    
                    <table style="width: 80%; margin: 0 auto; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #f5a9ac; page-break-inside: avoid;">
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; width: 40%; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Ext rod length
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_ext_rod_length or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Field height
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_field_height or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Required Electrical wire
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_electrical_wire or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Mounting structure
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_mounting_structure or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Distance between crane top and Rafter bottom
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.inst_crane_rafter_distance or ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Height arrangement scope
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_height_arrangement_scope == 'our_scope'">Our Scope</t>
                                <t t-if="doc.inst_height_arrangement_scope == 'client_scope'">Client Scope</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Stay arrangement scope
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.inst_stay_arrangement_scope == 'our_scope'">Our Scope</t>
                                <t t-if="doc.inst_stay_arrangement_scope == 'client_scope'">Client Scope</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #f5a9ac; border-left: 1px solid #f5a9ac; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                Other important Information
                            </td>
                            <td style="border-bottom: 1px solid #f5a9ac; border-right: 1px solid #f5a9ac; padding: 16px 24px; font-size: 14px; white-space: pre-wrap; line-height: 1.7;">
                                <t t-esc="doc.inst_other_info or ''"/>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </t>
</template>

</odoo>
