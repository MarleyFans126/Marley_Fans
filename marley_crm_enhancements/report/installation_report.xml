<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper format with running header/footer -->
    <record id="paperformat_installation" model="report.paperformat">
        <field name="name">Installation Report Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">35</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- Installation Report Action -->
    <record id="action_report_installation" model="ir.actions.report">
        <field name="name">Installation Report</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">marley_crm_enhancements.report_installation</field>
        <field name="report_file">marley_crm_enhancements.report_installation</field>
        <field name="print_report_name">'Installation - %s' % object.partner_id.name</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_installation"/>
    </record>

</odoo>
