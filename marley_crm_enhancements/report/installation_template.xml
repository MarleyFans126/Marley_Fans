                <!-- ============ PAGE BODY ============ -->
                <div class="page" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1a1a2e; font-size: 13px;">

                    <!-- ============ TITLE ============ -->
                    <div style="text-align: center; margin: 10px 0 22px 0;">
                        <span style="font-size: 18px; color: #333;">
                            Installation for: <t t-esc="doc.partner_id.name"/>
                        </span>
                    </div>

                    <!-- Resolve partner for address -->
                    <t t-set="addr_partner" t-value="doc.partner_id"/>
                    <t t-if="not addr_partner.street and doc.lead_id and doc.lead_id.partner_id and doc.lead_id.partner_id.street">
                        <t t-set="addr_partner" t-value="doc.lead_id.partner_id"/>
                    </t>

                    <!-- ============ DETAILS TABLE ============ -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #e0e0e0;">
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; width: 38%; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Sales Representative
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.lead_id and doc.lead_id.user_id">
                                    <t t-esc="doc.lead_id.user_id.name"/>
                                </t>
                                <t t-elif="doc.user_id">
                                    <t t-esc="doc.user_id.name"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: middle;">
                                Scheduled Installation Date
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.installation_date">
                                    <t t-esc="doc.installation_date" t-options='{"widget": "date", "format": "MMM dd, yyyy"}'/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                Company Details
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                <t t-esc="addr_partner.name"/><br/>
                                <t t-if="addr_partner.street"><t t-esc="addr_partner.street"/>,<br/></t>
                                <t t-if="addr_partner.street2"><t t-esc="addr_partner.street2"/>,<br/></t>
                                <t t-if="addr_partner.city"><t t-esc="addr_partner.city"/></t>
                                <t t-if="addr_partner.state_id"> <t t-esc="addr_partner.state_id.name"/></t>
                                <t t-if="addr_partner.country_id"> (<t t-esc="addr_partner.country_id.code"/>)</t>
                                <t t-if="addr_partner.zip"> <t t-esc="addr_partner.zip"/>.</t>
                                <br/>
                                <t t-if="addr_partner.vat">
                                    GSTIN <t t-esc="addr_partner.vat"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                Site Contact Person<br/>
                                Contact number
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                <t t-esc="doc.site_contact_person or ''"/><br/>
                                <t t-esc="doc.site_contact_number or ''"/>
                            </td>
                        </tr>
                        <t t-if="doc.site_address_street or doc.site_address_city">
                            <tr>
                                <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-weight: bold; font-size: 14px; vertical-align: top;">
                                    Installation Site Address
                                </td>
                                <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: top; line-height: 1.7;">
                                    <t t-if="doc.site_address_street"><t t-esc="doc.site_address_street"/>,<br/></t>
                                    <t t-if="doc.site_address_street2"><t t-esc="doc.site_address_street2"/>,<br/></t>
                                    <t t-if="doc.site_address_city"><t t-esc="doc.site_address_city"/></t>
                                    <t t-if="doc.site_address_state_id"> <t t-esc="doc.site_address_state_id.name"/></t>
                                    <t t-if="doc.site_address_zip"> - <t t-esc="doc.site_address_zip"/></t>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <!-- ============ PRODUCT MODEL / TERMS ============ -->
                    <h4 style="text-align: center; color: #333; font-weight: bold; font-size: 14px; margin: 22px 0 12px 0;">
                        Product Model/ Box &amp; quantity | weight | Terms
                    </h4>

                    <!-- Fetch sale orders linked to this project's lead -->
                    <t t-set="so_orders" t-value="doc.env['sale.order'].search([('opportunity_id', '=', doc.lead_id.id)])" t-if="doc.lead_id"/>
                    <t t-set="so_orders" t-value="doc.env['sale.order']" t-if="not doc.lead_id"/>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #e0e0e0;">
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; width: 60%; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Models to transport
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.models_to_transport">
                                    | <t t-esc="doc.models_to_transport"/> |
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Transportation terms:
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.transportation_terms == 'paid'">Paid</t>
                                <t t-if="doc.transportation_terms == 'to_pay'">To Pay</t>
                                <t t-if="doc.transportation_terms == 'to_be_billed'">To be Billed</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Invoice Value:
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.invoice_value">
                                    <t t-esc="'{:,.1f}'.format(doc.invoice_value)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Advance Received:
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-if="doc.advance_received">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.advance_received)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Balance Amount:
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle; font-weight: bold;">
                                <t t-if="doc.balance_amount">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.balance_amount)"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 1px solid #e0e0e0; border-left: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; font-weight: bold; vertical-align: middle;">
                                Amount In Words:
                            </td>
                            <td style="border-bottom: 1px solid #e0e0e0; border-right: 1px solid #e0e0e0; padding: 16px 24px; font-size: 14px; vertical-align: middle;">
                                <t t-esc="doc.amount_in_words or ''"/>
                            </td>
                        </tr>
                    </table>

                    <!-- ============ PRODUCT LINES TABLE ============ -->
                    <t t-set="all_lines" t-value="so_orders.mapped('order_line').filtered(lambda l: not l.display_type and l.product_id)" t-if="so_orders"/>

                    <t t-if="so_orders and all_lines">
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; page-break-inside: auto;">
                            <thead>
                                <tr style="border-top: 2px solid #ccc; border-bottom: 2px solid #ccc;">
                                    <th style="padding: 10px 12px; text-align: left; font-weight: bold; font-size: 13px; color: #555; width: 10%;">
                                        Sr. No.
                                    </th>
                                    <th style="padding: 10px 12px; text-align: left; font-weight: bold; font-size: 13px; color: #555; width: 50%;">
                                        Product
                                    </th>
                                    <th style="padding: 10px 12px; text-align: center; font-weight: bold; font-size: 13px; color: #555; width: 20%;">
                                        Box Qty
                                    </th>
                                    <th style="padding: 10px 12px; text-align: right; font-weight: bold; font-size: 13px; color: #555; width: 20%;">
                                        Weight/unit
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sno" t-value="0"/>
                                <t t-set="total_box_qty" t-value="0"/>
                                <t t-set="total_weight" t-value="0"/>
                                <t t-set="total_product_qty" t-value="0"/>
                                <t t-foreach="all_lines" t-as="line">
                                    <t t-set="sno" t-value="sno + 1"/>
                                    <t t-set="l_box_qty" t-value="line.x_box_qty if 'x_box_qty' in line._fields and line.x_box_qty else line.product_uom_qty"/>
                                    <t t-set="l_weight" t-value="line.x_weight_per_unit if 'x_weight_per_unit' in line._fields and line.x_weight_per_unit else (line.product_id.weight or 0)"/>
                                    <t t-set="total_box_qty" t-value="total_box_qty + l_box_qty"/>
                                    <t t-set="total_weight" t-value="total_weight + (l_box_qty * l_weight)"/>
                                    <t t-set="total_product_qty" t-value="total_product_qty + l_box_qty"/>
                                    <tr style="border-bottom: 1px solid #e0e0e0; page-break-inside: avoid;">
                                        <td style="padding: 14px 12px; text-align: center; font-size: 13px; vertical-align: top;">
                                            <t t-esc="sno"/>
                                        </td>
                                        <td style="padding: 14px 12px; font-size: 13px; vertical-align: top;">
                                            <t t-esc="line.product_id.name or line.name"/>
                                        </td>
                                        <td style="padding: 14px 12px; text-align: center; font-size: 13px; vertical-align: top;">
                                            <t t-esc="'%.1f' % l_box_qty"/>
                                        </td>
                                        <td style="padding: 14px 12px; text-align: right; font-size: 13px; vertical-align: top;">
                                            <t t-esc="'%.1f' % l_weight"/> kg.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS ROW -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; border-top: 2px solid #ccc; border-bottom: 2px solid #ccc; page-break-inside: avoid;">
                            <tr>
                                <td style="padding: 10px 14px; width: 33%; font-size: 13px;">
                                    <strong>Total Box Qty:</strong>&#160;&#160;
                                    <t t-esc="'%.1f' % total_box_qty"/>
                                </td>
                                <td style="padding: 10px 14px; width: 34%; font-size: 13px; border-left: 1px solid #e0e0e0;">
                                    <strong>Total Weight:</strong>&#160;&#160;
                                    <t t-esc="'%.1f' % total_weight"/> kg
                                </td>
                                <td style="padding: 10px 14px; width: 33%; font-size: 13px; border-left: 1px solid #e0e0e0;">
                                    <strong>Product total Qty:</strong>&#160;&#160;
                                    <t t-esc="int(total_product_qty)"/>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <!-- ============ SITE SPECIFICATION ============ -->
                    <h4 style="text-align: center; color: #333; font-weight: bold; font-size: 14px; margin: 22px 0 12px 0;">
                        Site Specification
                    </h4>

                    <table style="width: 80%; margin: 0 auto; border-collapse: collapse; margin-bottom: 24px; border-top: 1px solid #e0e0e0; page-break-inside: avoid;">
                        <tr>
