<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" keeps the admin's active toggle after subsequent module upgrades -->
    <data noupdate="1">
        <record id="ir_cron_fetch_aajjo_leads" model="ir.cron">
            <field name="name">AAJJO: Sync Leads</field>
            <field name="model_id" ref="model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model.fetch_aajjo_leads_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
