<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Email sent to client when lead moves New -> Qualify -->
        <record id="email_template_lead_qualified" model="mail.template">
            <field name="name">Lead Qualified - Client Notification</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Your Inquiry {{ object.name }} - Salesperson Assigned</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; font-family: Arial, sans-serif; color: #333;">
                    <p style="font-size: 14px; margin-bottom: 12px;">
                        Dear <t t-out="object.contact_name or object.partner_name or 'Customer'"/>,
                    </p>
                    <p style="font-size: 14px; margin-bottom: 12px;">
                        Thank you for your interest in <strong>Marley HVLS Fans</strong>.
                        We are pleased to inform you that your inquiry regarding
                        <strong><t t-out="object.name"/></strong> has been reviewed and qualified.
                    </p>
                    <p style="font-size: 14px; margin-bottom: 8px;">
                        A dedicated salesperson has been assigned to assist you with your requirements:
                    </p>
                    <table style="border-collapse: collapse; margin: 10px 0 16px 0; font-size: 14px;">
                        <tr>
                            <td style="padding: 6px 14px 6px 0; font-weight: bold;">Salesperson Name</td>
                            <td style="padding: 6px 0;">: <t t-out="object.user_id.name or 'N/A'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 14px 6px 0; font-weight: bold;">Mobile Number</td>
                            <td style="padding: 6px 0;">: <t t-out="object.user_id.partner_id.phone or object.user_id.partner_id.mobile or 'N/A'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 14px 6px 0; font-weight: bold;">Email ID</td>
                            <td style="padding: 6px 0;">: <t t-out="object.user_id.email or 'N/A'"/></td>
                        </tr>
                    </table>
                    <p style="font-size: 14px; margin-bottom: 12px;">
                        Our salesperson will be reaching out to you shortly to discuss your requirements in detail.
                        Please feel free to contact them directly for any immediate queries.
                    </p>
                    <p style="font-size: 14px; margin-bottom: 4px;">
                        Best regards,
                    </p>
                    <p style="font-size: 14px; font-weight: bold; margin: 0;">
                        Marley Enterprises Private Limited
                    </p>
                    <p style="font-size: 12px; color: #777; margin-top: 4px;">
                        HVLS Fan Solutions
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

</odoo>
