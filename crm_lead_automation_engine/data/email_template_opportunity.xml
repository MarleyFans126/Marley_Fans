<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Email sent to contact when lead is converted to opportunity -->
        <record id="email_template_opportunity_acknowledgment" model="mail.template">
            <field name="name">Opportunity Acknowledgment (Auto)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Thank you for your interest — {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                    <p style="font-size: 14px;">
                        Dear <t t-out="object.contact_name or object.partner_name or 'Customer'"/>,
                    </p>
                    <p style="font-size: 13px;">
                        Thank you for reaching out to <strong>Marley Fans</strong>.
                        We have received your inquiry regarding
                        <strong><t t-out="object.name"/></strong> and a dedicated
                        team member has been assigned to assist you.
                    </p>
                    <t t-if="object.user_id">
                        <p style="font-size: 13px;">
                            Your point of contact:
                        </p>
                        <ul style="font-size: 13px;">
                            <li><strong>Name:</strong> <t t-out="object.user_id.name"/></li>
                            <li><strong>Email:</strong> <t t-out="object.user_id.email or 'N/A'"/></li>
                            <li><strong>Phone:</strong> <t t-out="object.user_id.partner_id.phone or 'N/A'"/></li>
                        </ul>
                    </t>
                    <p style="font-size: 13px;">
                        We will get back to you shortly with more details.
                    </p>
                    <br/>
                    <p style="font-size: 13px;">
                        Best regards,<br/>
                        <strong>Marley Fans Sales Team</strong>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

</odoo>
