<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action: Manual Acknowledgment Trigger -->
    <record id="action_send_acknowledgment_manual" model="ir.actions.server">
        <field name="name">Send Acknowledgment (Manual)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_debug_send_acknowledgment()
        </field>
    </record>

    <!-- Server Action: Manual Reset Flags -->
    <record id="action_enable_automation_fields_manual" model="ir.actions.server">
        <field name="name">Reset/Force Automation Flags</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_debug_reset_flags()
        </field>
    </record>
    
    <!-- Server Action: Manual Duplicate Check -->
    <record id="action_run_duplicate_check_manual" model="ir.actions.server">
        <field name="name">Check Duplicates (Manual)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_manual_duplicate_check()
        </field>
    </record>
</odoo>
