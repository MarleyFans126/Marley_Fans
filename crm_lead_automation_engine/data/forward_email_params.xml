<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Defaults for incoming-email forwarding. noupdate=1 so a client change
         in Settings is never overwritten on upgrade; the records are still
         created on first install / upgrade if missing. -->
    <data noupdate="1">
        <record id="param_forward_incoming_email" model="ir.config_parameter">
            <field name="key">crm_automation.forward_incoming_email</field>
            <field name="value">True</field>
        </record>
        <record id="param_forward_ops_email" model="ir.config_parameter">
            <field name="key">crm_automation.forward_ops_email</field>
            <field name="value">operations@marleyfans.in</field>
        </record>
    </data>
</odoo>
