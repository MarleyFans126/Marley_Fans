<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Common Lead Acknowledgment Email Template -->
        <record id="email_template_lead_acknowledgment" model="mail.template">
            <field name="name">Lead Acknowledgment Email (Common)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Thank you for your interest!</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="object.contact_name or 'Customer'"/>,
                        <br/><br/>
                        Thank you for contacting us. We have received your inquiry regarding 
                        <strong t-out="object.name"/> and our team will get back to you shortly.
                        <br/><br/>
                        Best regards,
                        <br/>
                        Sales Team
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Salesperson Assigned Email Template -->
        <record id="email_template_salesperson_assigned" model="mail.template">
            <field name="name">Salesperson Assigned Email (Common)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Salesperson Assigned: {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.contact_name or 'Customer'"/>,
                        <br/><br/>
                        Your inquiry regarding <strong t-out="object.name"/> has been moved to the <strong>Qualify</strong> stage.
                        <br/><br/>
                        A dedicated salesperson has been assigned to assist you:
                        <ul>
                            <li><strong>Name:</strong> <t t-out="object.user_id.name or 'N/A'"/></li>
                            <li><strong>Mobile:</strong> <t t-out="object.user_id.partner_id.phone or 'N/A'"/></li>
                            <li><strong>Email:</strong> <t t-out="object.user_id.email or 'N/A'"/></li>
                        </ul>
                        <br/>
                        They will be contacting you shortly.
                        <br/><br/>
                        Best regards,
                        <br/>
                        Sales Team
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
