<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_crm_automation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crm.automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="after">

                <app data-string="CRM Automation" string="CRM Automation"
                     name="crm_lead_automation_engine"
                     groups="base.group_system">

                    <!-- Stage emails are now handled by Automated Actions (Stage-Based Email Sender) -->

                    <block title="WhatsApp Notifications"
                           name="crm_automation_whatsapp_block">

                        <setting id="crm_auto_whatsapp_setting"
                                 string="Auto WhatsApp on Opportunity"
                                 help="When enabled, a WhatsApp template message (lead_auto_thankyou) is automatically sent to the customer when a lead is converted to an opportunity.">
                            <field name="crm_auto_whatsapp_enabled" widget="boolean_toggle"/>
                        </setting>

                        <setting id="crm_qualify_whatsapp_setting"
                                 string="Auto WhatsApp on Qualify"
                                 help="When a lead moves to Qualify stage, automatically send a WhatsApp message (lead_qualified_notification) to the client with salesperson details. Variables: Client Name, Salesperson Name, Phone, Email.">
                            <field name="crm_qualify_whatsapp_enabled" widget="boolean_toggle"/>
                        </setting>

                    </block>

                    <block title="Incoming Email Forwarding"
                           name="crm_automation_forward_block">

                        <setting id="crm_forward_incoming_email_setting"
                                 string="Forward Incoming Customer Emails"
                                 help="When a customer emails a lead — a reply to our mails or a fresh email routed to a lead — forward a copy to the operations mailbox and to the assigned salesperson (and second salesperson, if set). It reaches their own inbox on top of appearing in the lead chatter.">
                            <field name="crm_forward_incoming_email" widget="boolean_toggle"/>
                            <div class="content-group mt-2" invisible="not crm_forward_incoming_email">
                                <div class="row">
                                    <label for="crm_forward_ops_email" string="Operations Mailbox" class="col-lg-4 o_light_label"/>
                                    <field name="crm_forward_ops_email" placeholder="operations@marleyfans.in"/>
                                </div>
                            </div>
                        </setting>

                    </block>
                </app>

            </xpath>
        </field>
    </record>

</odoo>
