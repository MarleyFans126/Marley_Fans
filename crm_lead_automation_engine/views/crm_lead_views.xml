<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
      1. TREE VIEW for OPPORTUNITIES (default Pipeline view)
    -->
    <record id="crm_case_tree_view_oppor_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <!-- Make duplicate rows stand out in red (Odoo 19 uses <list> not <tree>) -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">duplicate_flag</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="before">
                <!-- Hidden flags used for row decoration -->
                <field name="duplicate_flag" column_invisible="1"/>
                <!-- Star indicator: Always visible -->
                <field name="duplicate_star" string=" " readonly="1"/>
            </xpath>

            <!-- Source column after Team -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="lead_source_type" string="Source" readonly="1" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='lead_source_type']" position="after">
                <field name="lead_source" string="Source" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!--
      2. TREE VIEW for LEADS (standard "Leads" menu - separate from Opportunities)
    -->
    <record id="crm_case_tree_view_leads_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.tree.leads.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <!-- Odoo 19: list view root element is <list>, not <tree> -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">duplicate_flag</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="before">
                <field name="duplicate_flag" column_invisible="1"/>
                <field name="duplicate_star" string=" " readonly="1"/>
            </xpath>

            <!-- Source column after Team -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="lead_source_type" string="Source" readonly="1" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='lead_source_type']" position="after">
                <field name="lead_source" string="Source" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!--
      3. FORM VIEW Inheritance (Duplicate Warning Banner)
    -->
    <record id="crm_lead_view_form_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Red warning banner above the sheet, visible only when flagged -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0 d-flex align-items-center gap-2"
                     role="alert" invisible="not duplicate_flag">
                    <strong style="font-size: 18px;">★ Duplicate Lead Detected</strong>
                    <span>— This lead shares a mobile number, email, or company name with
                        <field name="duplicate_count" readonly="1" class="oe_inline" nolabel="1"/>
                        other lead(s)
                    </span>
                    <button name="action_manual_duplicate_check" type="object"
                            string="Re-check" class="btn btn-sm btn-warning ms-auto"
                            help="Re-run duplicate detection for this lead"/>
                </div>
            </xpath>
            <!-- Lead Source fields shown right under the Mobile (phone) field -->
            <xpath expr="//field[@name='lost_reason_id'][1]" position="before">
                <field name="lead_source_type" string="Lead Source" readonly="1"
                       invisible="lead_source"/>
                <field name="lead_source" string="Lead Source"
                       invisible="lead_source_type"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="inquiry_creation_date"/>
            </xpath>
        </field>
    </record>
    
    <!-- 
      4. SEARCH VIEW Filter 
    -->
    <!-- KANBAN — show a "Duplicate" badge on the card so it's visible on the
         Pipeline board (the list view already colours duplicate rows red). -->
    <record id="crm_lead_kanban_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/field[@name='name']" position="before">
                <field name="duplicate_flag" invisible="1"/>
                <span t-if="record.duplicate_flag.raw_value"
                      class="badge text-bg-danger float-end ms-1"
                      title="Shares a phone, email, or similar company name with another lead">★ Duplicate</span>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_leads_filter_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">

            <!-- Inject extra searchable fields BEFORE the first existing
                 <field>, so they show up at the top of the search dropdown.
                 "Search Anywhere" uses filter_domain to OR-match across many
                 columns from a single typed term. -->
            <xpath expr="//search/field[1]" position="before">
                <field name="contact_name" string="Search Anywhere"
                       filter_domain="['|','|','|','|','|','|','|',
                           ('name','ilike',self),
                           ('partner_name','ilike',self),
                           ('contact_name','ilike',self),
                           ('email_from','ilike',self),
                           ('phone','ilike',self),
                           ('lead_source','ilike',self),
                           ('business_area','ilike',self),
                           ('description','ilike',self)]"/>
                <field name="lead_source" string="Lead Source"/>
                <field name="business_area" string="Business Area"
                       filter_domain="[('business_area','ilike',self)]"/>
            </xpath>

            <filter name="salesperson" position="after">
                <separator/>
                <filter string="Is Duplicate" name="duplicate" domain="[('duplicate_flag', '=', True)]"/>
                <separator/>
                <filter string="IndiaMART" name="source_indiamart" domain="[('lead_source_type', '=', 'indiamart')]"/>
                <filter string="AAJJO" name="source_aajjo" domain="[('lead_source_type', '=', 'aajjo')]"/>
                <filter string="Manual" name="source_manual"
                        domain="[('is_aajjo', '=', False), ('is_indiamart', '=', False)]"/>
            </filter>

            <!-- Widen "My Leads" to include records where user is second_salesperson -->
            <filter name="assigned_to_me" position="attributes">
                <attribute name="domain">['|', ('user_id', '=', uid), ('second_salesperson_id', '=', uid)]</attribute>
            </filter>
        </field>
    </record>

    <!--
      Widen "My Pipeline" on the opportunity search view too so that leads
      where the current user is the Second Salesperson appear under it.
    -->
    <record id="view_crm_case_opportunities_filter_inherit_automation" model="ir.ui.view">
        <field name="name">crm.lead.opportunity.search.inherit.automation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">

            <!-- "Search Anywhere" + Lead Source on the Pipeline view -->
            <xpath expr="//search/field[1]" position="before">
                <field name="contact_name" string="Search Anywhere"
                       filter_domain="['|','|','|','|','|','|','|',
                           ('name','ilike',self),
                           ('partner_name','ilike',self),
                           ('contact_name','ilike',self),
                           ('email_from','ilike',self),
                           ('phone','ilike',self),
                           ('lead_source','ilike',self),
                           ('business_area','ilike',self),
                           ('description','ilike',self)]"/>
                <field name="lead_source" string="Lead Source"/>
                <field name="business_area" string="Business Area"
                       filter_domain="[('business_area','ilike',self)]"/>
            </xpath>

            <filter name="assigned_to_me" position="attributes">
                <attribute name="domain">['|', ('user_id', '=', uid), ('second_salesperson_id', '=', uid)]</attribute>
            </filter>

            <!-- Lead source filters on the Pipeline / opportunities search view -->
            <filter name="salesperson" position="after">
                <separator/>
                <filter string="IndiaMART" name="source_indiamart" domain="[('lead_source_type', '=', 'indiamart')]"/>
                <filter string="AAJJO" name="source_aajjo" domain="[('lead_source_type', '=', 'aajjo')]"/>
                <filter string="Manual" name="source_manual"
                        domain="[('is_aajjo', '=', False), ('is_indiamart', '=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
