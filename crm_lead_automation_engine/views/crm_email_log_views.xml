<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="crm_email_log_view_tree" model="ir.ui.view">
        <field name="name">crm.email.log.tree</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <list string="Email Logs" default_order="sent_date desc">
                <field name="sent_date"/>
                <field name="lead_name"/>
                <field name="partner_name"/>
                <field name="email_to"/>
                <field name="template_used"/>
                <field name="status" decoration-success="status == 'sent'" decoration-danger="status == 'failed'" decoration-info="status == 'queued'" widget="badge"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="crm_email_log_view_form" model="ir.ui.view">
        <field name="name">crm.email.log.form</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <form string="Email Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="lead_name"/>
                            <field name="partner_name"/>
                            <field name="email_to"/>
                        </group>
                        <group>
                            <field name="template_used"/>
                            <field name="status"/>
                            <field name="sent_date"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="crm_email_log_view_search" model="ir.ui.view">
        <field name="name">crm.email.log.search</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <search string="Email Logs">
                <field name="lead_name"/>
                <field name="partner_name"/>
                <field name="email_to"/>
                <filter name="filter_sent" string="Sent" domain="[('status', '=', 'sent')]"/>
                <filter name="filter_failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_queued" string="Queued" domain="[('status', '=', 'queued')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="crm_email_log_action" model="ir.actions.act_window">
        <field name="name">Email Logs</field>
        <field name="res_model">crm.email.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="crm_email_log_view_search"/>
    </record>

    <!-- Menu: CRM > Reporting > Email Logs -->
    <menuitem
        id="menu_crm_email_log"
        name="Email Logs"
        parent="crm.crm_menu_report"
        action="crm_email_log_action"
        sequence="30"/>

</odoo>
