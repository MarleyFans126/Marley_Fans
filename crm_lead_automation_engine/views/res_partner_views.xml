<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Add a Business Area field on the contact form.
        It auto-fetches into the CRM lead's Business Area when this contact
        is set as the lead's customer.
    -->
    <record id="view_partner_form_inherit_business_area" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.business_area</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Anchor on the address block's zip field (class o_address_zip).
                 That class only exists on the FORM's city/zip pair, so this
                 xpath cannot accidentally match the tree-view city. -->
            <xpath expr="//field[@name='zip'][hasclass('o_address_zip')]" position="after">
                <field name="business_area" placeholder="e.g. IDA Jeedimetla, Phase IV"/>
            </xpath>
        </field>
    </record>

</odoo>
