<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="sale_terms_template_view_list" model="ir.ui.view">
        <field name="name">sale.terms.template.list</field>
        <field name="model">sale.terms.template</field>
        <field name="arch" type="xml">
            <list string="Terms Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="sale_terms_template_view_form" model="ir.ui.view">
        <field name="name">sale.terms.template.form</field>
        <field name="model">sale.terms.template</field>
        <field name="arch" type="xml">
            <form string="Terms Template">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name" placeholder="e.g. Standard, Express, OEM"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <separator string="Terms &amp; Conditions Body"/>
                    <field name="body"
                           nolabel="1"
                           placeholder="Full terms and conditions text — warranty, delivery, payment, bank details, customer scope, validity, etc. — written as a single narrative."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sale_terms_template" model="ir.actions.act_window">
        <field name="name">Terms Templates</field>
        <field name="res_model">sale.terms.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Terms &amp; Conditions draft
            </p>
            <p>
                Drafts are reusable T&amp;C blocks (warranty, delivery, payment, bank, etc.)
                that salespeople pick on a quotation to auto-fill the Terms tab.
            </p>
        </field>
    </record>

    <!-- Menu — under Sales → Configuration -->
    <menuitem id="menu_sale_terms_template"
              name="Terms Templates"
              parent="sale.menu_sale_config"
              action="action_sale_terms_template"
              sequence="50"/>

</odoo>
