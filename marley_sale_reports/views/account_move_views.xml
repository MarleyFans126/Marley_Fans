<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Proforma bank + commercial terms tab on Invoice form -->
    <record id="account_move_view_form_inherit_marley_proforma" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.marley.proforma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <!-- WhatsApp Send Button in header -->
            <xpath expr="//form//header" position="inside">
                <button name="action_open_whatsapp_send_wizard"
                        string="WhatsApp"
                        type="object"
                        class="btn-success"
                        icon="fa-whatsapp"
                        invisible="not partner_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Proforma Invoice Details" name="marley_proforma_details">

                    <group string="Proforma Print Options">
                        <group>
                            <field name="proforma_with_taxes"/>
                            <field name="proforma_print_terms"/>
                            <field name="advance_payment_percentage"/>
                            <field name="advance_tax_percentage"
                                   invisible="not proforma_with_taxes"/>
                        </group>
                        <group>
                            <field name="proforma_tax_amount" string="GST 18% Amount" readonly="1"/>
                            <field name="proforma_amount_total" readonly="1"/>
                            <field name="advance_amount_due" readonly="1"/>
                        </group>
                    </group>

                    <group string="Bank Details (for Proforma Invoice PDF)">
                        <group>
                            <field name="proforma_bank_name"/>
                            <field name="proforma_bank_account_number"/>
                            <field name="proforma_bank_account_type"/>
                        </group>
                        <group>
                            <field name="proforma_bank_ifsc"/>
                            <field name="proforma_bank_branch"/>
                        </group>
                    </group>

                    <group string="Commercial Terms (for Proforma Invoice PDF)">
                        <group>
                            <field name="proforma_gst_note"/>
                            <field name="proforma_offer_validity"/>
                        </group>
                        <group>
                            <field name="proforma_warranty"/>
                        </group>
                    </group>
                    <group>
                        <group string="Delivery Terms">
                            <field name="proforma_delivery" nolabel="1"/>
                        </group>
                        <group string="Payment Terms (Text)">
                            <field name="proforma_payment_terms_text" nolabel="1"/>
                        </group>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
