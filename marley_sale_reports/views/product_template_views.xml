<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Per-product warranty terms (shown on quotations/proforma) -->
    <record id="product_template_form_view_inherit_marley" model="ir.ui.view">
        <field name="name">product.template.form.inherit.marley</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Marley Quotation Print">
                    <field name="marley_weight"/>
                    <field name="warranty_terms"
                           placeholder="Warranty text shown on quotations / proforma invoices for this product..."/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
