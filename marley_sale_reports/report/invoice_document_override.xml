<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Standalone Marley invoice document template.
        Called from the report_invoice wrapper via _get_name_invoice_report().
        Does NOT inherit account.report_invoice_document — avoids breaking child views.
    -->
    <template id="report_marley_invoice_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

            <!-- Resolve linked Sale Order for custom fields -->
            <t t-set="linked_so" t-value="o.invoice_line_ids.sale_line_ids.order_id[:1]"/>

            <style>
                @page { margin-top: 0mm !important; }
                .article { margin-top: 0 !important; padding-top: 0 !important; }
                table td, table th { -webkit-print-color-adjust: exact; }
                .marley-q-body { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000; line-height: 1.7; }
                .marley-q-body table { page-break-inside: auto; }
                .marley-q-body tr { page-break-inside: avoid; }
                .marley-q-body .section-heading { font-size: 15px; font-weight: bold; text-decoration: underline; margin: 18px 0 8px 0; }
                .marley-q-body .section-text { font-size: 13px; margin: 6px 0; line-height: 1.7; }
                                .footer table, .footer table tr, .footer table td,
                    .bank-details-table, .bank-details-table tr, .bank-details-table td { border: 0 !important; border-collapse: collapse !important; }
                </style>

            <!-- ============ RUNNING HEADER (logo only) ============ -->
            <div class="header" style="margin: 0; padding: 0;">
                <div style="position: relative; height: 90px;">
                    <div style="position: absolute; top: 10px; left: 30px; z-index: 10;">
                        <img src="/marley_sale_reports/static/src/img/marley_logo.png" alt="Marley" style="height: 70px; width: auto;"/>
                    </div>
                </div>
            </div>

            <!-- ============ RUNNING FOOTER ============ -->
            <div class="footer" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                <div style="border-top: 3px solid #e30613; padding-top: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 10px; color: #333; border: none; letter-spacing: 0.2px; table-layout: fixed;">
                        <tr>
                            <td style="width: 40%; vertical-align: top; border: none; padding: 0 8px 0 0;">
                                <strong style="color: #e30613;">Website:</strong> www.marleyfans.in
                            </td>
                            <td style="width: 30%; vertical-align: top; border: none; padding: 0 8px; text-align: center;">
                                <strong style="color: #e30613;">CIN:</strong> U29308TG2021PTC156778
                            </td>
                            <td style="width: 30%; vertical-align: top; border: none; padding: 0 0 0 8px; text-align: right;">
                                <strong style="color: #e30613;">GSTIN:</strong> 36AAPCM1629P1ZS
                            </td>
                        </tr>
                        <tr>
                            <td colspan="3" style="padding: 4px 0 0 0; font-size: 8px; border: none; white-space: nowrap;">
                                <strong style="color: #e30613;">Corporate Address:</strong> Second Floor, Swapna Nilayam, H.NO.5-5-81/7/A, Plot No.20, High Tension Rd, Prakash Nagar, Kukatpally, Hyderabad, Telangana 500072, India
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ============ BODY ============ -->
            <div class="marley-q-body">

                <div style="margin-bottom: 8px; font-size: 15px;">
                    <strong>Kind Attention:</strong>
                    <span style="float: right; font-weight: bold;">
                        Invoice # <t t-if="o.name and o.name != '/'" t-esc="o.name"/><t t-else="">Draft</t>
                    </span>
                </div>
                <div style="margin-bottom: 6px; font-size: 14px;">
                    <t t-if="linked_so and linked_so.kind_attn"><t t-esc="linked_so.kind_attn"/></t>
                    <t t-elif="o.partner_id.child_ids"><t t-esc="o.partner_id.child_ids[0].name"/></t>
                    <t t-else=""><t t-esc="o.partner_id.name"/></t>
                </div>

                <div style="margin-bottom: 14px; line-height: 1.7; font-size: 14px;">
                    <strong>To,</strong><br/>
                    <strong><t t-esc="o.partner_id.name"/></strong>
                    <t t-if="o.partner_id.street"><br/><t t-esc="o.partner_id.street"/></t>
                    <t t-if="o.partner_id.street2"><br/><t t-esc="o.partner_id.street2"/></t>
                    <br/>
                    <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/>, </t>
                    <t t-if="o.partner_id.state_id"><t t-esc="o.partner_id.state_id.name"/> </t>
                    <t t-if="o.partner_id.zip"><t t-esc="o.partner_id.zip"/></t>
                    <t t-if="o.partner_id.vat"><br/><strong>GST: </strong><t t-esc="o.partner_id.vat"/></t>
                    <t t-if="o.partner_id.phone"><br/><strong>Phone: </strong><t t-esc="o.partner_id.phone"/></t>
                    <t t-if="o.partner_id.email"><br/><strong>Email: </strong><t t-esc="o.partner_id.email"/></t>
                </div>

                <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; border: 1px solid #f5a9ac;">
                    <tr style="background-color: #f5f5f5;">
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 20%;">Invoice Date</td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 20%;">Due Date</td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 30%;">Sales Representative</td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 30%;">Connect</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                            <t t-if="o.invoice_date"><t t-esc="o.invoice_date" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/></t>
                        </td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                            <t t-if="o.invoice_date_due"><t t-esc="o.invoice_date_due" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/></t>
                        </td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                            <t t-esc="o.invoice_user_id.name or ''"/>
                        </td>
                        <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                            <t t-if="o.invoice_user_id.phone"><t t-esc="o.invoice_user_id.phone"/> </t>
                            <t t-if="o.invoice_user_id.email"><t t-esc="o.invoice_user_id.email"/></t>
                        </td>
                    </tr>
                </table>

                <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; border: 1px solid #f5a9ac;">
                    <thead>
                        <tr style="background-color: #f0f0f0; font-weight: bold;">
                            <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: left; font-size: 13px; width: 42%;">DESCRIPTION</th>
                            <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; width: 13%;">QUANTITY</th>
                            <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 15%;">UNIT PRICE</th>
                            <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; width: 14%;">TAXES</th>
                            <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 16%;">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                            <tr style="page-break-inside: avoid;">
                                <td style="border: 1px solid #f5a9ac; padding: 10px 8px; font-size: 13px; vertical-align: top; line-height: 1.7;">
                                    <strong><t t-esc="line.product_id.name or line.name"/></strong>
                                            <t t-set="_pname" t-value="(line.product_id.name or '').strip()"/>
                                            <t t-set="_lname" t-value="(line.name or '').strip()"/>
                                            <t t-set="_extra" t-value="_lname[len(_pname):].strip() if _pname and _lname.startswith(_pname) else _lname"/>
                                            <t t-if="_extra and _extra != _pname">
                                                <br/><span style="font-size: 12px; color: #333; white-space: pre-line;"><t t-esc="_extra"/></span>
                                            </t>
                                </td>
                                <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; vertical-align: top;">
                                    <t t-esc="'%.2f' % line.quantity"/> <t t-esc="line.product_uom_id.name or 'Units'"/>
                                </td>
                                <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top;">
                                    <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                </td>
                                <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 12px; vertical-align: top;">
                                    <t t-foreach="line.tax_ids" t-as="tax">
                                        <t t-esc="tax.name"/><br/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top; font-weight: bold;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <t t-set="tax_totals" t-value="o.tax_totals"/>
                <table style="width: 50%; margin-left: auto; border-collapse: collapse; margin-bottom: 20px;">
                    <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                        <tr>
                            <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                <t t-esc="subtotal.get('name', 'Untaxed Amount')"/>
                            </td>
                            <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac; width: 35%;">
                                &#8377; <t t-esc="'{:,.2f}'.format(subtotal.get('base_amount_currency', 0))"/>
                            </td>
                        </tr>
                        <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                            <tr>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                    <t t-esc="tax_group.get('group_name', 'Tax')"/>
                                </td>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(tax_group.get('tax_amount_currency', 0))"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <tr style="background-color: #f0f0f0;">
                        <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac;">Total</td>
                        <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac;">
                            &#8377; <t t-esc="'{:,.2f}'.format(tax_totals.get('total_amount_currency', o.amount_total))"/>
                        </td>
                    </tr>
                    <t t-if="o.amount_residual and o.amount_residual != o.amount_total">
                        <tr>
                            <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">Amount Paid</td>
                            <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                &#8377; <t t-esc="'{:,.2f}'.format(o.amount_total - o.amount_residual)"/>
                            </td>
                        </tr>
                        <tr style="background-color: #fff3cd;">
                            <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac;">Amount Due</td>
                            <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; color: #c00;">
                                &#8377; <t t-esc="'{:,.2f}'.format(o.amount_residual)"/>
                            </td>
                        </tr>
                    </t>
                </table>

                <div style="margin-bottom: 14px;">
                    <div class="section-heading">TAXES &amp; DUTIES:</div>
                    <p class="section-text">GST at the rate of 18% shall be applicable on above quoted price. If there is any change in Tax structure or any statutory levies are introduced by the appropriate Government at the time of shipment additional charges will have to be borne by the BUYER as per actual.</p>
                </div>

                <t t-if="linked_so and linked_so.customer_scope">
                    <div style="margin-bottom: 14px;">
                        <div class="section-heading">EXCLUSION:</div>
                        <p class="section-text" style="white-space: pre-line;"><t t-esc="linked_so.customer_scope"/></p>
                    </div>
                </t>

                <div style="margin-bottom: 14px;">
                    <div class="section-heading">TERMS &amp; CONDITIONS:</div>
                    <t t-set="_seen_w" t-value="[]"/>
                    <t t-if="linked_so">
                        <t t-foreach="linked_so.order_line.filtered(lambda l: l.product_id and (l.product_id.warranty_terms or '').strip())" t-as="_wline">
                            <t t-set="_wt" t-value="_wline.product_id.warranty_terms.strip()"/>
                            <t t-if="_wt not in _seen_w">
                                <t t-set="_dummy" t-value="_seen_w.append(_wt)"/>
                            </t>
                        </t>
                    </t>
                    <t t-if="_seen_w">
                        <p class="section-text" style="margin-bottom: 4px;">
                            <strong>QUALITY ASSURANCE &amp; WARRANTY:</strong>
                        </p>
                        <t t-foreach="_seen_w" t-as="_wt">
                            <p class="section-text" style="margin: 2px 0 2px 14px; white-space: pre-line;">&#8226; <t t-esc="_wt"/></p>
                        </t>
                    </t>
                </div>

                <div style="margin-bottom: 14px;">
                    <div class="section-heading">PAYMENT SCHEDULE:</div>
                    <div class="section-text" style="white-space: pre-line;"><t t-if="linked_so and linked_so.payment_terms_text"><t t-esc="linked_so.payment_terms_text"/></t><t t-else="">100% advance along with your confirmed order.
Purchase Order should be on the name of Marley Enterprises Private Limited.
Payments to be issued to us by way of Pay-order/DD/at par Cheque. All payments received by us will be forfeited in case of cancellation of order.</t></div>
                </div>

                <div style="margin-bottom: 14px;">
                    <strong style="font-size: 15px;">Bank Details :</strong>
                    <div style="margin-top: 6px; font-size: 13px; line-height: 1.7;">
                                <div><span style="display: inline-block; width: 120px;">Account Name</span>: Marley Enterprises Private Limited</div>
                                <div><span style="display: inline-block; width: 120px;">Account No.</span>: <t t-esc="(linked_so and linked_so.bank_account_number) or '50200092737354'"/></div>
                                <div><span style="display: inline-block; width: 120px;">Bank Name</span>: <t t-esc="(linked_so and linked_so.bank_name) or 'HDFC Bank'"/></div>
                                <div><span style="display: inline-block; width: 120px;">Bank Branch</span>: <t t-esc="(linked_so and linked_so.bank_branch) or 'Kukatpally, Hyderabad'"/></div>
                                <div><span style="display: inline-block; width: 120px;">IFSC Code</span>: <t t-esc="(linked_so and linked_so.bank_ifsc) or 'HDFC0000364'"/></div>
                            </div>
                </div>

                <div style="margin-bottom: 14px;">
                    <div class="section-heading">DELIVERY SCHEDULE:</div>
                    <p class="section-text">
                        <t t-if="linked_so and linked_so.delivery_terms"><t t-esc="linked_so.delivery_terms"/></t>
                        <t t-else="">Marley FAN will be delivered to your site within 15 to 20 Days from date we receive your techno-commercially clear
                        purchase-order, subject to your adherence to the agreed payment schedule and availability of material.</t>
                    </p>
                </div>

                <div style="margin-top: 24px; font-size: 14px;">
                    <p>Best Regards,</p>
                    <p style="font-weight: bold;">Marley Enterprises Pvt. Ltd</p>
                </div>

            </div>
        </t>
    </template>

    <!-- Hook into the report_invoice wrapper so our template gets called -->
    <template id="report_invoice_marley_hook"
              inherit_id="account.report_invoice">
        <xpath expr="//t[@t-foreach='docs']" position="inside">
            <t t-if="o._get_name_invoice_report() == 'marley_sale_reports.report_marley_invoice_document'"
               t-call="marley_sale_reports.report_marley_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>

</odoo>
