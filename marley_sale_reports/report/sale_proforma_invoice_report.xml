<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Marley Proforma Invoice bound to sale.order — standalone PDF, not linked to any account.move -->
    <record id="action_report_marley_sale_proforma" model="ir.actions.report">
        <field name="name">Marley Proforma Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">marley_sale_reports.report_marley_sale_proforma</field>
        <field name="report_file">marley_sale_reports.report_marley_sale_proforma</field>
        <field name="print_report_name">'Proforma Invoice - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="marley_sale_reports.paperformat_marley_quotation"/>
    </record>

</odoo>
