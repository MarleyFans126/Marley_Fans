<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_marley_sale_proforma">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.basic_layout">
                <t t-set="doc" t-value="doc"/>

                <style>
                    @page { margin-top: 0mm !important; }
                    .article { margin-top: 0 !important; padding-top: 0 !important; }
                    table td, table th { -webkit-print-color-adjust: exact; }
                    .marley-inv-body { font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #000; line-height: 1.7; }
                    .marley-inv-body table { page-break-inside: auto; }
                    .marley-inv-body tr { page-break-inside: avoid; }
                    .marley-inv-body .section-heading { font-size: 15px; font-weight: bold; text-decoration: underline; margin: 18px 0 8px 0; }
                    .marley-inv-body .section-text { font-size: 13px; margin: 6px 0; line-height: 1.7; }
                                    .footer table, .footer table tr, .footer table td,
                    .bank-details-table, .bank-details-table tr, .bank-details-table td { border: 0 !important; border-collapse: collapse !important; }
                </style>

                <!-- ============ RUNNING HEADER ============ -->
                <div class="header" style="margin: 0; padding: 0;">
                    <div style="position: relative; height: 90px;">
                        <div style="position: absolute; top: 10px; left: 30px; z-index: 10;">
                            <img src="/marley_sale_reports/static/src/img/marley_logo.png" alt="Marley" style="height: 70px; width: auto;"/>
                        </div>
                    </div>
                </div>

                <!-- ============ RUNNING FOOTER ============ -->
                <div class="footer" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                    <div style="border-top: 3px solid #e30613; padding-top: 8px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 10px; color: #333; border: none; letter-spacing: 0.2px; table-layout: fixed;">
                            <tr>
                                <td style="width: 40%; vertical-align: top; border: none; padding: 0 8px 0 0;">
                                    <strong style="color: #e30613;">Website:</strong> www.marleyfans.in
                                </td>
                                <td style="width: 30%; vertical-align: top; border: none; padding: 0 8px; text-align: center;">
                                    <strong style="color: #e30613;">CIN:</strong> U29308TG2021PTC156778
                                </td>
                                <td style="width: 30%; vertical-align: top; border: none; padding: 0 0 0 8px; text-align: right;">
                                    <strong style="color: #e30613;">GSTIN:</strong> 36AAPCM1629P1ZS
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="padding: 4px 0 0 0; font-size: 8px; border: none; white-space: nowrap;">
                                    <strong style="color: #e30613;">Corporate Address:</strong> Second Floor, Swapna Nilayam, H.NO.5-5-81/7/A, Plot No.20, High Tension Rd, Prakash Nagar, Kukatpally, Hyderabad, Telangana 500072, India
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- ============ BODY ============ -->
                <div class="marley-inv-body">

                    <!-- ===== CENTERED TITLE ===== -->
                    <div style="text-align: center; margin: 0 0 6px 0;">
                        <span style="font-size: 20px; font-weight: bold; color: #e30613; text-decoration: underline; letter-spacing: 2px;">
                            PROFORMA INVOICE
                        </span>
                    </div>

                    <!-- ===== PROFORMA # ===== -->
                    <div style="margin-bottom: 8px; font-size: 15px;">
                        <span style="float: right; font-weight: bold;">
                            Proforma #
                            <t t-if="doc.financial_year_label"><t t-esc="doc.financial_year_label"/>/</t>
                            <t t-esc="doc.name"/>
                        </span>
                        <div style="clear: both;"/>
                    </div>

                    <!-- ===== TO ADDRESS ===== -->
                    <div style="margin-bottom: 14px; line-height: 1.7; font-size: 14px;">
                        <strong>To,</strong><br/>
                        <!-- Company (commercial entity), not the contact person -->
                        <strong><t t-esc="doc.partner_id.commercial_partner_id.name"/></strong>
                        <t t-if="doc.partner_id.street"><br/><t t-esc="doc.partner_id.street"/></t>
                        <t t-if="doc.partner_id.street2"><br/><t t-esc="doc.partner_id.street2"/></t>
                        <br/>
                        <t t-if="doc.partner_id.city"><t t-esc="doc.partner_id.city"/>, </t>
                        <t t-if="doc.partner_id.state_id"><t t-esc="doc.partner_id.state_id.name"/> </t>
                        <t t-if="doc.partner_id.zip"><t t-esc="doc.partner_id.zip"/></t>
                        <t t-if="doc.partner_id.vat"><br/><strong>GST: </strong><t t-esc="doc.partner_id.vat"/></t>
                        <t t-if="doc.partner_id.phone"><br/><strong>Phone: </strong><t t-esc="doc.partner_id.phone"/></t>
                        <t t-if="doc.partner_id.email"><br/><strong>Email: </strong><t t-esc="doc.partner_id.email"/></t>
                    </div>

                    <!-- ===== INFO ROW ===== -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; border: 1px solid #f5a9ac;">
                        <tr style="background-color: #f5f5f5;">
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 25%;">Proforma Date</td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 25%;">P.O. Reference</td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 25%;">Sales Representative</td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-weight: bold; font-size: 13px; width: 25%;">Connect</td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                                <t t-if="doc.proforma_date">
                                    <t t-esc="doc.proforma_date" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                </t>
                                <t t-elif="doc.date_order">
                                    <t t-esc="doc.date_order" t-options='{"widget": "date", "format": "dd-MMM-yyyy"}'/>
                                </t>
                            </td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                                <t t-esc="doc.client_order_ref or ''"/>
                            </td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                                <t t-esc="doc.user_id.name or ''"/>
                            </td>
                            <td style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px;">
                                <t t-set="rep_phone" t-value="(doc.user_id.phone or doc.user_id.partner_id.phone or '') if doc.user_id else ''"/>
                                <t t-if="rep_phone"><t t-esc="rep_phone"/><br/></t>
                                <t t-if="doc.user_id.email"><t t-esc="doc.user_id.email"/></t>
                            </td>
                        </tr>
                    </table>

                    <!-- ===== LINE ITEMS TABLE ===== -->
                    <!-- WITH TAXES -->
                    <t t-if="doc.proforma_with_taxes">
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; border: 1px solid #f5a9ac;">
                            <thead>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: left; font-size: 13px; width: 40%;">DESCRIPTION</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; width: 12%;">QUANTITY</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 15%;">UNIT PRICE</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; width: 15%;">TAXES</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 18%;">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <!-- Section heading row -->
                                    <tr t-if="line.display_type == 'line_section'" style="page-break-inside: avoid;">
                                        <td colspan="5" style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px; font-weight: bold; background-color: #fafafa;">
                                            <t t-esc="line.name"/>
                                        </td>
                                    </tr>
                                    <!-- Note row -->
                                    <tr t-elif="line.display_type == 'line_note'" style="page-break-inside: avoid;">
                                        <td colspan="5" style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 12px; font-style: italic; white-space: pre-line;">
                                            <t t-esc="line.name"/>
                                        </td>
                                    </tr>
                                    <!-- Product row (only if selected to print) -->
                                    <tr t-elif="line.print_on_proforma" style="page-break-inside: avoid;">
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; font-size: 13px; vertical-align: top; line-height: 1.7;">
                                            <strong><t t-esc="line.product_id.name or line.name"/></strong>
                                            <t t-set="_pname" t-value="(line.product_id.name or '').strip()"/>
                                            <t t-set="_lname" t-value="(line.name or '').strip()"/>
                                            <t t-set="_extra" t-value="_lname[len(_pname):].strip() if _pname and _lname.startswith(_pname) else _lname"/>
                                            <t t-if="_extra and _extra != _pname">
                                                <br/><span style="font-size: 12px; color: #333; white-space: pre-line;"><t t-esc="_extra"/></span>
                                            </t>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; vertical-align: top;">
                                            <t t-esc="'%.2f' % line.product_uom_qty"/>
                                            <t t-if="line.product_uom_id"> <t t-esc="line.product_uom_id.name"/></t>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top;">
                                            &#8377; <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 12px; vertical-align: top;">
                                            GST @ 18%
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top; font-weight: bold;">
                                            &#8377; <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS with taxes — aligned to product cols
                             (40/12/15/15/18); coloured backgrounds on cells. -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; page-break-inside: avoid;">
                            <colgroup>
                                <col style="width: 40%;"/>
                                <col style="width: 12%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 18%;"/>
                            </colgroup>
                            <tr>
                                <td colspan="3" style="border: none; background: transparent;"/>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">Untaxed Amount</td>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.proforma_amount_untaxed)"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="border: none; background: transparent;"/>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">GST @ 18%</td>
                                <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.proforma_tax_amount)"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="border: none; background: transparent;"/>
                                <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #f0f0f0;">Total</td>
                                <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #f0f0f0;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.proforma_amount_total)"/>
                                </td>
                            </tr>
                            <t t-if="doc.advance_tax_percentage">
                                <tr>
                                    <td colspan="3" style="border: none; background: transparent;"/>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                        GST in Advance (<t t-esc="'%g' % doc.advance_tax_percentage"/>%)
                                    </td>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.proforma_tax_amount * doc.advance_tax_percentage / 100.0)"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="doc.advance_payment_percentage > 0">
                                <tr>
                                    <td colspan="3" style="border: none; background: transparent;"/>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                        Advance To Be Paid Now
                                    </td>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 1px solid #f5a9ac; color: #1b2a4a;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.advance_amount_due)"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="doc.advance_received > 0">
                                <tr>
                                    <td colspan="3" style="border: none; background: transparent;"/>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                        Advance Received
                                    </td>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.advance_received)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" style="border: none; background: transparent;"/>
                                    <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #fff6e6;">Balance Due</td>
                                    <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #fff6e6;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.balance_due)"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <!-- WITHOUT TAXES -->
                    <t t-if="not doc.proforma_with_taxes">
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; border: 1px solid #f5a9ac;">
                            <thead>
                                <tr style="background-color: #f0f0f0; font-weight: bold;">
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: left; font-size: 13px; width: 45%;">DESCRIPTION</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; width: 15%;">QUANTITY</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 20%;">UNIT PRICE</th>
                                    <th style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; width: 20%;">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <!-- Section heading row -->
                                    <tr t-if="line.display_type == 'line_section'" style="page-break-inside: avoid;">
                                        <td colspan="4" style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 13px; font-weight: bold; background-color: #fafafa;">
                                            <t t-esc="line.name"/>
                                        </td>
                                    </tr>
                                    <!-- Note row -->
                                    <tr t-elif="line.display_type == 'line_note'" style="page-break-inside: avoid;">
                                        <td colspan="4" style="border: 1px solid #f5a9ac; padding: 8px 10px; font-size: 12px; font-style: italic; white-space: pre-line;">
                                            <t t-esc="line.name"/>
                                        </td>
                                    </tr>
                                    <!-- Product row (only if selected to print) -->
                                    <tr t-elif="line.print_on_proforma" style="page-break-inside: avoid;">
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; font-size: 13px; vertical-align: top; line-height: 1.7;">
                                            <strong><t t-esc="line.product_id.name or line.name"/></strong>
                                            <t t-set="_pname" t-value="(line.product_id.name or '').strip()"/>
                                            <t t-set="_lname" t-value="(line.name or '').strip()"/>
                                            <t t-set="_extra" t-value="_lname[len(_pname):].strip() if _pname and _lname.startswith(_pname) else _lname"/>
                                            <t t-if="_extra and _extra != _pname">
                                                <br/><span style="font-size: 12px; color: #333; white-space: pre-line;"><t t-esc="_extra"/></span>
                                            </t>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: center; font-size: 13px; vertical-align: top;">
                                            <t t-esc="'%.2f' % line.product_uom_qty"/>
                                            <t t-if="line.product_uom_id"> <t t-esc="line.product_uom_id.name"/></t>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top;">
                                            &#8377; <t t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                        </td>
                                        <td style="border: 1px solid #f5a9ac; padding: 10px 8px; text-align: right; font-size: 13px; vertical-align: top; font-weight: bold;">
                                            &#8377; <t t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS without taxes — aligned to product cols
                             (45/15/20/20); coloured backgrounds on cells. -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; page-break-inside: avoid;">
                            <colgroup>
                                <col style="width: 45%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 20%;"/>
                                <col style="width: 20%;"/>
                            </colgroup>
                            <tr>
                                <td colspan="2" style="border: none; background: transparent;"/>
                                <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #f0f0f0;">Total</td>
                                <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #f0f0f0;">
                                    &#8377; <t t-esc="'{:,.2f}'.format(doc.proforma_amount_untaxed)"/>
                                </td>
                            </tr>
                            <t t-if="doc.advance_payment_percentage > 0">
                                <tr>
                                    <td colspan="2" style="border: none; background: transparent;"/>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                        Advance To Be Paid Now
                                    </td>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 1px solid #f5a9ac; color: #1b2a4a;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.advance_amount_due)"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="doc.advance_received > 0">
                                <tr>
                                    <td colspan="2" style="border: none; background: transparent;"/>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; border: 1px solid #f5a9ac;">
                                        Advance Received
                                    </td>
                                    <td style="padding: 8px 12px; text-align: right; font-size: 13px; font-weight: bold; border: 1px solid #f5a9ac;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.advance_received)"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border: none; background: transparent;"/>
                                    <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #fff6e6;">Balance Due</td>
                                    <td style="padding: 10px 12px; text-align: right; font-size: 14px; font-weight: bold; border: 2px solid #f5a9ac; background-color: #fff6e6;">
                                        &#8377; <t t-esc="'{:,.2f}'.format(doc.balance_due)"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <!-- ===== TERMS SECTIONS ===== -->
                    <t t-if="doc.proforma_print_terms">

                        <!-- TAXES &amp; DUTIES -->
                        <div style="margin-bottom: 14px;">
                            <div class="section-heading">TAXES &amp; DUTIES:</div>
                            <p class="section-text">GST at the rate of 18% shall be applicable on above quoted price.</p>
                        </div>

                        <!-- WARRANTY -->
                        <t t-set="_seen_w" t-value="[]"/>
                        <t t-foreach="doc.order_line.filtered(lambda l: l.product_id and (l.product_id.warranty_terms or '').strip())" t-as="_wline">
                            <t t-set="_wt" t-value="_wline.product_id.warranty_terms.strip()"/>
                            <t t-if="_wt not in _seen_w">
                                <t t-set="_dummy" t-value="_seen_w.append(_wt)"/>
                            </t>
                        </t>
                        <t t-if="_seen_w">
                            <div style="margin-bottom: 14px;">
                                <div class="section-heading">TERMS &amp; CONDITIONS:</div>
                                <p class="section-text" style="margin-bottom: 4px;">
                                    <strong>QUALITY ASSURANCE &amp; WARRANTY:</strong>
                                </p>
                                <t t-foreach="_seen_w" t-as="_wt">
                                    <p class="section-text" style="margin: 2px 0 2px 14px; white-space: pre-line;">&#8226; <t t-esc="_wt"/></p>
                                </t>
                            </div>
                        </t>

                        <!-- PAYMENT SCHEDULE -->
                        <t t-if="doc.payment_terms_text">
                            <div style="margin-bottom: 14px;">
                                <div class="section-heading">PAYMENT SCHEDULE:</div>
                                <div class="section-text" style="white-space: pre-line;"><t t-esc="doc.payment_terms_text"/></div>
                            </div>
                        </t>

                        <!-- BANK DETAILS -->
                        <div style="margin-bottom: 14px;">
                            <strong style="font-size: 15px;">Bank Details :</strong>
                            <div style="margin-top: 6px; font-size: 13px; line-height: 1.7;">
