<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         GST TAX GROUPS
         ============================================================ -->
    <record id="tax_group_sgst" model="account.tax.group">
        <field name="name">SGST</field>
        <field name="sequence">10</field>
    </record>
    <record id="tax_group_cgst" model="account.tax.group">
        <field name="name">CGST</field>
        <field name="sequence">11</field>
    </record>
    <record id="tax_group_igst" model="account.tax.group">
        <field name="name">IGST</field>
        <field name="sequence">12</field>
    </record>
    <record id="tax_group_gst" model="account.tax.group">
        <field name="name">GST</field>
        <field name="sequence">5</field>
    </record>

    <!-- ============================================================
         SINGLE FLAT SALE TAX — GST 18% (no CGST/SGST/IGST split)
         Used as the default sale tax. A single 18% line keeps
         quotations / proformas simple per Marley's requirement.
         ============================================================ -->
    <record id="gst_sale_18" model="account.tax">
        <field name="name">GST 18%</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">18</field>
        <field name="tax_group_id" ref="tax_group_gst"/>
        <field name="description">GST 18%</field>
        <field name="sequence">1</field>
    </record>

    <!-- ============================================================
         SALE TAXES — SGST 9% + CGST 9% (Intra-State = 18%)
         ============================================================ -->
    <record id="sgst_sale_9" model="account.tax">
        <field name="name">SGST Sale 9%</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">9</field>
        <field name="tax_group_id" ref="tax_group_sgst"/>
        <field name="description">SGST 9%</field>
        <field name="sequence">10</field>
    </record>
    <record id="cgst_sale_9" model="account.tax">
        <field name="name">CGST Sale 9%</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">9</field>
        <field name="tax_group_id" ref="tax_group_cgst"/>
        <field name="description">CGST 9%</field>
        <field name="sequence">11</field>
    </record>

    <!-- ============================================================
         SALE TAXES — IGST 18% (Inter-State)
         ============================================================ -->
    <record id="igst_sale_18" model="account.tax">
        <field name="name">IGST Sale 18%</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">percent</field>
        <field name="amount">18</field>
        <field name="tax_group_id" ref="tax_group_igst"/>
        <field name="description">IGST 18%</field>
        <field name="sequence">12</field>
    </record>

    <!-- ============================================================
         PURCHASE TAXES — SGST 9% + CGST 9% (Intra-State = 18%)
         ============================================================ -->
    <record id="sgst_purchase_9" model="account.tax">
        <field name="name">SGST Purchase 9%</field>
        <field name="type_tax_use">purchase</field>
        <field name="amount_type">percent</field>
        <field name="amount">9</field>
        <field name="tax_group_id" ref="tax_group_sgst"/>
        <field name="description">SGST 9%</field>
        <field name="sequence">10</field>
    </record>
    <record id="cgst_purchase_9" model="account.tax">
        <field name="name">CGST Purchase 9%</field>
        <field name="type_tax_use">purchase</field>
        <field name="amount_type">percent</field>
        <field name="amount">9</field>
        <field name="tax_group_id" ref="tax_group_cgst"/>
        <field name="description">CGST 9%</field>
        <field name="sequence">11</field>
    </record>

    <!-- ============================================================
         PURCHASE TAXES — IGST 18% (Inter-State)
         ============================================================ -->
    <record id="igst_purchase_18" model="account.tax">
        <field name="name">IGST Purchase 18%</field>
        <field name="type_tax_use">purchase</field>
        <field name="amount_type">percent</field>
        <field name="amount">18</field>
        <field name="tax_group_id" ref="tax_group_igst"/>
        <field name="description">IGST 18%</field>
        <field name="sequence">12</field>
    </record>

    <!-- ============================================================
         FISCAL POSITION: Intra-State (Same State → SGST + CGST)
         Auto-applies when customer state = company state (Telangana)
         ============================================================ -->
    <record id="fiscal_position_intra_state" model="account.fiscal.position">
        <field name="name">Intra State (SGST + CGST)</field>
        <field name="auto_apply" eval="True"/>
        <field name="country_id" ref="base.in"/>
        <field name="state_ids" eval="[(4, ref('base.state_in_ts'))]"/>
        <field name="sequence">1</field>
    </record>

    <!-- ============================================================
         FISCAL POSITION: Inter-State (Different State → IGST)
         Auto-applies when customer is in India but different state
         ============================================================ -->
    <record id="fiscal_position_inter_state" model="account.fiscal.position">
        <field name="name">Inter State (IGST)</field>
        <field name="auto_apply" eval="True"/>
        <field name="country_id" ref="base.in"/>
        <field name="sequence">2</field>
    </record>

</odoo>
