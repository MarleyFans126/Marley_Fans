<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_incoming_mail" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.incoming.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="after">

                <app data-string="Incoming Mails" string="Incoming Mails"
                     name="techmatic_incoming_mail"
                     groups="base.group_system">

                    <block title="Internal Forwarding" name="tim_forward_block">
                        <setting id="tim_forward_setting"
                                 string="Forward Incoming Customer Emails"
                                 help="When a customer emails a lead — a reply, or a fresh email that lands on the lead — forward a copy to the internal mailboxes below and to the assigned (and secondary) salesperson, so it reaches their own inbox on top of the lead chatter.">
                            <field name="tim_forward_enabled" widget="boolean_toggle"/>
                            <div class="content-group mt-2" invisible="not tim_forward_enabled">
                                <div class="row">
                                    <label for="tim_ops_email" string="Internal Recipients"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="tim_ops_email"
                                           placeholder="operations@marleyfans.in, sales@marleyfans.in"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-8 offset-lg-4 text-muted small">
                                        Comma-separated. The lead's assigned salesperson is always
                                        added automatically.
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Reliable Fetch" name="tim_fetch_block">
                        <setting id="tim_rescan_setting"
                                 string="Read-Independent Fetch"
                                 help="Import recent mail even if it was already opened (marked read) in the webmail inbox before Odoo fetched it. Odoo skips any message it has already imported, so nothing is duplicated.">
                            <field name="tim_rescan_enabled" widget="boolean_toggle"/>
                            <div class="content-group mt-2" invisible="not tim_rescan_enabled">
                                <div class="row">
                                    <label for="tim_rescan_days" string="Look-back (days)"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="tim_rescan_days" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-8 offset-lg-4 text-muted small">
                                        How far back each fetch scans (1–30). Only genuinely new
                                        mail is downloaded.
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Health Watchdog" name="tim_health_block">
                        <setting id="tim_health_setting"
                                 string="Incoming Mail Watchdog"
                                 help="Check the incoming-mail pipeline every hour and email an alert the moment it breaks — mailbox connection down, fetch stalled, or routing/config missing. Turns a silent failure into a loud one.">
                            <field name="tim_health_enabled" widget="boolean_toggle"/>
                            <div class="content-group mt-2" invisible="not tim_health_enabled">
                                <div class="row">
                                    <label for="tim_health_alert_email" string="Alert Recipients"
                                           class="col-lg-4 o_light_label"/>
                                    <field name="tim_health_alert_email"
                                           placeholder="tech@techmaticsys.com"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-8 offset-lg-4 text-muted small">
                                        Comma-separated. Leave blank to alert the forwarding
                                        mailboxes, then system administrators.
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>

            </xpath>
        </field>
    </record>

</odoo>
