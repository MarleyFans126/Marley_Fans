<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Defaults for incoming-email forwarding. noupdate=1 so a change made in
         Settings is never overwritten on upgrade; the records are still created
         on first install / upgrade if missing. -->
    <data noupdate="1">
        <record id="param_tim_forward_enabled" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.forward_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_tim_ops_email" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.ops_email</field>
            <field name="value">operations@marleyfans.in,sales@marleyfans.in</field>
        </record>
        <record id="param_tim_rescan_enabled" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.rescan_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_tim_rescan_days" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.rescan_days</field>
            <field name="value">3</field>
        </record>
        <record id="param_tim_health_enabled" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.health_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_tim_health_stale_hours" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.health_stale_hours</field>
            <field name="value">2</field>
        </record>
        <record id="param_tim_health_throttle_hours" model="ir.config_parameter">
            <field name="key">techmatic_incoming_mail.health_throttle_hours</field>
            <field name="value">6</field>
        </record>
    </data>
</odoo>
