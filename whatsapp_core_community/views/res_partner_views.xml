<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Extend res.partner form view (base.view_partner_form):
        - Add WhatsApp icon inline beside Phone field
    -->
    <record id="view_partner_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Remove Smart Buttons: message count + send button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Stat buttons removed for a cleaner Enterprise-style look -->
            </xpath>

            <!-- Add WhatsApp icon beside Phone field -->
            <xpath expr="//field[@name='phone']" position="after">
                <button name="action_open_whatsapp_send_wizard"
                        type="object"
                        class="btn btn-link p-0 ms-1"
                        icon="fa-whatsapp"
                        title="Send WhatsApp Message"
                        invisible="not phone"
                        style="color: #25D366; font-size: 1.2rem; vertical-align: baseline;"
                        help="Send WhatsApp Message"/>
            </xpath>

        </field>
    </record>

</odoo>
