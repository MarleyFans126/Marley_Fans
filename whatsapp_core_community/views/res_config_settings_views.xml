<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        WhatsApp Configuration in General Settings
        Inherits base.res_config_settings_view_form
        Adds a dedicated WhatsApp section with Enterprise-like UI
    -->
    <record id="action_whatsapp_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="base.res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'whatsapp_core_community'}</field>
    </record>

    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <app data-string="WhatsApp" string="WhatsApp" name="whatsapp_core_community"
                     groups="base.group_system">

                    <block title="WhatsApp Cloud API Configuration"
                           name="whatsapp_config_block">

                        <!-- Enable Toggle -->
                        <setting id="whatsapp_enabled_setting"
                                 string="Enable WhatsApp Integration"
                                 help="Activate WhatsApp Cloud API for this Odoo instance.">
                            <field name="whatsapp_enabled" widget="boolean_toggle"/>
                        </setting>

                        <!-- Configuration Fields - Only shown when enabled -->
                        <div invisible="not whatsapp_enabled">

                            <!-- Connection Status Badges -->
                            <div class="row mt-3 mb-3">
                                <div class="col-12">
                                    <div class="alert alert-success d-flex align-items-center"
                                         role="alert"
                                         invisible="whatsapp_connection_status != 'connected'">
                                        <i class="fa fa-check-circle me-2" title="Success"/>

                                        <div>
                                            <strong>Connected to WhatsApp Business API</strong>
                                            <span class="ms-2 text-muted">Connection verified successfully</span>
                                        </div>
                                    </div>
                                    <div class="alert alert-danger d-flex align-items-center"
                                         role="alert"
                                         invisible="whatsapp_connection_status != 'failed'">
                                        <i class="fa fa-times-circle me-2" title="Error"/>

                                        <div>
                                            <strong>Connection Failed</strong>
                                            <span class="ms-2 text-muted">Please check your credentials and try again</span>
                                        </div>
                                    </div>
                                    <div class="alert alert-warning d-flex align-items-center"
                                         role="alert"
                                         invisible="whatsapp_connection_status != 'not_tested'">
                                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>

                                        <div>
                                            <strong>Not Tested Yet</strong>
                                            <span class="ms-2 text-muted">Use the "Test Connection" button below to verify your credentials</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Business Account ID -->
                            <setting string="Business Account ID"
                                     help="Your WhatsApp Business Account ID from Meta Business Manager → Settings."
                                     id="whatsapp_business_account_id_setting">
                                <div class="content-group">
                                    <field name="whatsapp_business_account_id"
                                           placeholder="e.g. 123456789012345"/>
                                </div>
                            </setting>

                            <!-- Phone Number ID -->
                            <setting string="Phone Number ID"
                                     help="The Phone Number ID from Meta Developer Portal → WhatsApp → API Setup."
                                     id="whatsapp_phone_number_id_setting">
                                <div class="content-group">
                                    <field name="whatsapp_phone_number_id"
                                           placeholder="e.g. 987654321098765"/>
                                </div>
                            </setting>

                            <!-- Permanent Access Token -->
                            <setting string="Permanent Access Token"
                                     help="Your permanent access token from Meta. Never share this. Store securely."
                                     id="whatsapp_access_token_setting">
                                <div class="content-group">
                                    <field name="whatsapp_access_token"
                                           password="True"
                                           placeholder="EAAxxxxxxxxxxxxx..."/>
                                </div>
                            </setting>

                            <!-- Webhook Verify Token -->
                            <setting string="Webhook Verify Token"
                                     help="A custom secret string you define. Enter the same value in Meta Developer Portal → Webhooks → Verify Token."
                                     id="whatsapp_webhook_verify_token_setting">
                                <div class="content-group">
                                    <field name="whatsapp_webhook_verify_token"
                                           placeholder="my_secret_verify_token_123"/>
                                </div>
                            </setting>

                            <!-- App ID -->
                            <setting string="App ID"
                                     help="Your Meta App ID."
                                     id="whatsapp_app_id_setting">
                                <div class="content-group">
                                    <field name="whatsapp_app_id"
                                           placeholder="123456789012345"/>
                                </div>
                            </setting>

                            <!-- App Secret -->
                            <setting string="App Secret"
                                     help="Your Meta App Secret. Used for signature verification."
                                     id="whatsapp_app_secret_setting">
                                <div class="content-group">
                                    <field name="whatsapp_app_secret"
                                           password="True"
                                           placeholder="xxxxxxxxx..."/>
                                </div>
                            </setting>

                            <!-- Action Buttons -->
                            <setting id="whatsapp_action_buttons_setting"
                                     string="API Actions"
                                     help="Test your connection and validate credentials with Meta API.">
                                <div class="content-group">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <button type="object"
                                                name="action_whatsapp_test_connection"
                                                string="Test Connection"
                                                class="btn btn-primary"/>
                                        <button type="object"
                                                name="action_whatsapp_validate_credentials"
                                                string="✔ Validate Credentials"
                                                class="btn btn-secondary"/>
                                    </div>
                                    <div class="text-muted mt-2">
                                        <small>
                                            <i class="fa fa-info-circle me-1" title="Info"/>

                                            Webhook URL for Meta:
                                            <code>/whatsapp/webhook</code>
                                            — prepend your Odoo base URL (e.g. https://yourodoo.com/whatsapp/webhook)
                                        </small>
                                    </div>
                                </div>
                            </setting>

                        </div><!-- /whatsapp_enabled -->

                    </block>
                </app>

            </xpath>
        </field>
    </record>

</odoo>
