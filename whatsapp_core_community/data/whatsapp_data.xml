<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default system parameters for WhatsApp Core -->
        <function model="ir.config_parameter" name="set_param">
            <value>whatsapp_core.enabled</value>
            <value>False</value>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value>whatsapp_core.api_version</value>
            <value>v19.0</value>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value>whatsapp_core.connection_status</value>
            <value>not_tested</value>
        </function>

        <record id="ir_cron_whatsapp_template_sync" model="ir.cron">
            <field name="name">WhatsApp: Sync Pending Templates</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_pending_templates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
